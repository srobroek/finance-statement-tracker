      "typeVersion": 2,
      "position": [
        100,
        0
      ],
      "parameters": {
        "jsCode": "const o=$('Read Nonterminal Actual Outbox').item.json,m=$json,h=$('SHA-256 Recovered Delta').item.json.recovered_sha256; if(h!==o.payload_sha256||m.schema_version!==o.artifact_schema_version||m.actual_file_id!==o.actual_file_id||m.config_version!==o.config_version) throw new Error('OUTBOX_RECOVERY_ARTIFACT_MISMATCH'); if(!Array.isArray(m.transactions)||!m.transactions.length) throw new Error('OUTBOX_RECOVERY_EMPTY'); return [{json:{outbox_row:o,manifest:m,verification:{account_id:m.account_id,start_date:m.period_start,end_date:m.period_end,expected_transactions:m.transactions,expected_account_balance:m.expected_statement_balance_minor}}}];"
      }
