    {
      "id": "18007",
      "name": "Validate Lease Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Validate Lease Result. Keep this deterministic and fail closed.\nconst req = $('Validate Fixed Lease Operation').first().json, row = $json;\nif (req.operation === 'ACQUIRE') {\n    if (!row.lease_id || Number(row.fencing_token) <= 0 || new Date(row.expires_at) <= new Date())\n        throw new Error('WRITER_LEASE_BUSY_OR_INVALID');\n    return [{ json: { operation: 'ACQUIRE', resource_key: String(row.resource_key), lease_id: String(row.lease_id), lease_owner: String(row.lease_owner), fencing_token: Number(row.fencing_token), expires_at: String(row.expires_at) } }];\n}\nif (req.operation === 'ASSERT' && row.valid !== true)\n    throw new Error('WRITER_LEASE_STALE');\nif (req.operation === 'RELEASE' && row.released !== true)\n    throw new Error('WRITER_LEASE_RELEASE_FAILED');\nreturn [{ json: { operation: req.operation, resource_key: req.resource_key, lease_id: req.lease_id, fencing_token: req.fencing_token, valid: row.valid === true, released: row.released === true } }];\n"
      }
    },
