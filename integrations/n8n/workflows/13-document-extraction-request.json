    {"id":"13002","name":"Validate Narrow Tool Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[-550,0],"parameters":{"jsCode":"const allowed=['document_id','expected_sha256','document_profile','requested_schema_version']; const forbidden=['url','filesystem_path','provider','password','credential','actual_account_id','commit']; for(const k of allowed) if(!$json[k]) throw new Error(`Missing ${k}`); for(const k of forbidden) if(Object.hasOwn($json,k)) throw new Error(`Forbidden model input ${k}`); if(!/^[a-f0-9]{64}$/i.test(String($json.expected_sha256))) throw new Error('expected_sha256 must be SHA-256 hex'); return [{json:Object.fromEntries(allowed.map(k=>[k,String($json[k])]))}];"}},
