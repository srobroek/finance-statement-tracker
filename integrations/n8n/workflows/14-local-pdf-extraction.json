    {
      "id": "14005",
      "name": "Deterministic Text Quality Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Deterministic Text Quality Gate. Keep this deterministic and fail closed.\nconst text = String($json.extracted_text || '');\nconst printable = (text.match(/[\\p{L}\\p{N}\\p{P}\\p{Zs}]/gu) || []).length;\nconst rows = text.split(/\\r?\\n/).filter(v => v.trim()).length;\nconst passed = text.length >= 200 && printable / Math.max(text.length, 1) >= 0.75 && rows >= 5;\nreturn [{ json: { ...$json, extracted_text: text, text_quality: { passed, characters: text.length, printable_ratio: printable / Math.max(text.length, 1), nonempty_lines: rows } } }];\n"
      }
    },
    {
      "id": "14006",
      "name": "Text Quality Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.text_quality.passed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
