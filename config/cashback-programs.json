  "route_policies": {
    "CATEGORY_BUCKET": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "target_rate_positive": true},
      "ranking": {"groups_by_pace": {"*": 0}},
      "reasons": {"*": "Category bucket has enough headroom for the whole purchase and its target-tier rate is active."}
    },
    "REWARD_BUCKET": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "net_value_positive": true},
      "ranking": {"groups_by_pace": {"UNDER": 1, "ON_PACE": 2, "OVER": 3, "SECURED": 3, "*": 2}},
      "reasons": {
        "UNDER": "Prioritize this card: its target is unmet, cycle pace is under, and this reward bucket has headroom.",
        "OVER": "Keep as a fallback: this reward bucket has headroom, but the card is already over cycle pace.",
        "*": "Reward bucket has headroom and positive economic value."
      }
    },
    "SPECIALIST": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "net_value_positive": true},
      "ranking": {"groups_by_pace": {"UNDER": 1, "ON_PACE": 2, "OVER": 3, "SECURED": 3, "OPEN": 3, "*": 3}},
      "reasons": {"*": "Eligible positive-value specialist remains available."}
    },
    "THRESHOLD_FILLER": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "target_unmet": true},
      "ranking": {"groups_by_pace": {"UNDER": 2, "ON_PACE": 4, "OVER": 5, "SECURED": 5, "*": 5}},
      "reasons": {
        "UNDER": "Use as threshold filler because the card target is unmet and cycle pace is under.",
        "*": "Keep as fallback filler: the card target is unmet, but higher-priority allocation needs are satisfied first."
      }
    },
    "FALLBACK": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "net_value_positive": true},
      "ranking": {"groups_by_pace": {"*": 6}},
      "reasons": {"*": "Eligible positive-value fallback remains available."}
    }
  },
