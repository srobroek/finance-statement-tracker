{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxsan.com/schemas/wealth-snapshot-v1.json",
  "title": "Provider-native wealth snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "source_identity", "capture_id",
    "provider_id", "currency", "captured_at", "as_of", "total_value",
    "portfolios", "exclusions", "reconciliation", "limitations", "stale_after_seconds"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_identity": {"type": "string", "minLength": 1},
    "capture_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date-time"},
    "total_value": {"type": "string"},
    "earnings": {"type": ["string", "null"]},
    "return_pct": {"type": ["string", "null"]},
    "portfolios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider_account_id", "display_name", "product_type", "currency",
          "as_of", "total_value", "positions", "cash_flows", "activity_status", "reconciliation",
          "include_in_net_worth", "closed", "limitations"
        ],
        "properties": {
          "provider_account_id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "product_type": {"enum": ["INVEST", "TRADE"]},
          "ownership": {"type": ["string", "null"]},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "as_of": {"type": "string", "format": "date-time"},
          "total_value": {"type": "string"},
          "cash_value": {"type": ["string", "null"]},
          "earnings": {"type": ["string", "null"]},
          "return_pct": {"type": ["string", "null"]},
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "instrument_id", "ticker", "name", "units", "market_value"
              ],
              "properties": {
                "instrument_id": {"type": "string", "minLength": 1},
                "ticker": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "exchange": {"type": ["string", "null"]},
                "units": {"type": "string"},
                "market_value": {"type": "string"},
                "unit_price": {"type": ["string", "null"]},
                "allocation_pct": {"type": ["string", "null"]},
                "performance_pct": {"type": ["string", "null"]},
                "corporate_action_context": {"type": ["string", "null"]}
              }
            }
          },
          "cash_flows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "occurred_at", "amount", "flow_type"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "occurred_at": {"type": "string", "format": "date-time"},
                "amount": {"type": "string"},
                "flow_type": {"enum": ["CONTRIBUTION", "WITHDRAWAL", "DIVIDEND", "FEE"]}
              }
            }
          },
          "activity_status": {"type": "string"},
          "reconciliation": {"$ref": "#/$defs/reconciliation"},
          "include_in_net_worth": {"type": "boolean"},
          "actual_account_name": {"type": ["string", "null"]},
          "closed": {"type": "boolean"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "display_name", "amount", "currency", "reason"],
        "properties": {
          "kind": {"type": "string"},
          "display_name": {"type": "string"},
          "amount": {"type": "string"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "reason": {"type": "string"}
        }
      }
    },
    "reconciliation": {"$ref": "#/$defs/reconciliation"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "stale_after_seconds": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "reconciliation": {
      "type": "object",
      "required": ["status", "expected", "actual", "difference", "tolerance"],
      "properties": {
        "status": {"type": "string"},
        "expected": {"type": "string"},
        "actual": {"type": ["string", "null"]},
        "difference": {"type": ["string", "null"]},
        "tolerance": {"type": "string"}
      }
    }
  }
}
