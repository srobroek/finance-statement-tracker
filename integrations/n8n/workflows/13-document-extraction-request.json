      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -820,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Validate Narrow Tool Input. Keep this deterministic and fail closed.\nconst allowed = ['document_id', 'expected_sha256', 'document_profile', 'requested_schema_version'];\nconst forbidden = ['url', 'filesystem_path', 'path', 'provider', 'password', 'credential', 'actual_account_id', 'actual_id', 'commit', 'command', 'folder_id', 'sender', 'subject'];\nfor (const k of allowed)\n    if (!$json[k])\n        throw new Error(`Missing ${k}`);\nfor (const k of forbidden)\n    if (Object.hasOwn($json, k))\n        throw new Error(`Forbidden input ${k}`);\nif (!/^[a-f0-9]{64}$/i.test(String($json.expected_sha256)))\n    throw new Error('expected_sha256 must be SHA-256 hex');\nreturn [{ json: Object.fromEntries(allowed.map(k => [k, String($json[k])])) }];\n"
      }
    },
    {
      "id": "13003",
      "name": "Load Immutable Document Record",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -520,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "finance_document_operations",
          "mode": "name"
        },
        "returnAll": false,
        "limit": 1,
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "document_id",
              "condition": "eq",
              "keyValue": "={{ $json.document_id }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
