{
  "schema_version": 1,
  "outlook": {
    "cursor_source": "outlook",
    "schedule": {
      "cadence": "HOURLY",
      "timezone": "Asia/Dubai",
      "minute": 5
    },
    "scan_overlap_hours": 2,
    "initial_lookback_hours": 24,
    "transaction_notifications": {
      "mode": "ALL_SINCE_CURSOR_WITH_OVERLAP",
      "source_registry": "config/transaction-email-sources.json"
    },
    "statement_pdfs": {
      "mode": "CARD_SPECIFIC_MONTHLY_JOB",
      "source_registry": "config/statement-sources.json",
      "selection": "LATEST_PER_CARD_AND_EXPECTED_CYCLE"
    }
  },
  "browser": {
    "sources": "config/browser-sources.json",
    "adapters": "browser_adapters",
    "capture_schema": "config/browser-capture-schema-v1.json",
    "prefer_official_export": true,
    "require_review_for_visible_rows": true,
    "allow_direct_actual_write": false
  }
}
