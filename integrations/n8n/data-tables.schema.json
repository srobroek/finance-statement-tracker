{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxsan.com/schemas/finance-n8n-data-tables-v3.json",
  "title": "Finance n8n Postgres Data Table contract",
  "type": "object",
  "required": ["schema_version", "storage", "contract_status", "state_policies", "tables"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 4},
    "storage": {"const": "n8n-data-tables-on-postgres"},
    "contract_status": {"const": "SPEC_ONLY"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "state_policies": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {
        "type": "object",
        "required": ["retention", "idempotency", "concurrency", "index_semantics"],
        "properties": {
          "retention": {"type": "string", "minLength": 8},
          "idempotency": {"type": "string", "minLength": 8},
          "concurrency": {"type": "string", "minLength": 8},
          "index_semantics": {"type": "string", "minLength": 8}
        },
        "additionalProperties": false
      }
    },
    "tables": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": ["name", "purpose", "idempotency_key", "columns"],
        "properties": {
          "name": {"type": "string", "pattern": "^finance_[a-z0-9_]+$"},
          "purpose": {"type": "string", "minLength": 8},
          "idempotency_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "columns": {"type": "object", "minProperties": 2, "additionalProperties": {"enum": ["string", "number", "boolean", "date"]}},
          "allowed_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "allowed_review_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
