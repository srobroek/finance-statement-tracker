        }
      }
    },
    {
      "id": "21005",
      "name": "Run Codex Subscription Provider",
      "type": "n8n-nodes-prodex.prodex",
      "typeVersion": 2,
      "position": [
        80,
        0
      ],
      "parameters": {
        "operation": "runAgent",
        "useN8nCredentials": false,
        "systemPrompt": "Finance proposal only. Never use tools or mutate data. Return only the schema-bound JSON proposal.",
        "skills": [],
        "prompt": "={{ $json.provider_prompt }}",
        "model": "={{ $json.provider_model }}",
        "reasoningEffort": "={{ $json.provider_reasoning_effort }}",
        "personality": "pragmatic",
        "threadMode": "new",
        "sandbox": "read_only",
        "workingDirectory": "",
        "options": {
          "outputSchema": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://vxsan.com/schemas/finance-ai-proposal-v1.json\",\"title\":\"Finance AI proposal-only result\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"schema_version\",\"job_id\",\"idempotency_key\",\"agent_provider\",\"policy_id\",\"policy_class\",\"policy_sha256\",\"config_sha256\",\"output_schema_sha256\",\"runner_receipt_id\",\"runner_model\",\"runner_reasoning_effort\",\"auth_mode\",\"proposals\"],\"properties\":{\"schema_version\":{\"type\":\"integer\",\"const\":1},\"job_id\":{\"type\":\"string\",\"pattern\":\"^finance-ai:[a-f0-9]{64}$\"},\"idempotency_key\":{\"type\":\"string\",\"pattern\":\"^[a-f0-9]{64}$\"},\"agent_provider\":{\"type\":\"string\",\"enum\":[\"CODEX_SUBSCRIPTION\",\"CLAUDE_SUBSCRIPTION\"]},\"policy_id\":{\"type\":\"string\",\"pattern\":\"^[a-z0-9][a-z0-9:_-]{0,127}$\"},\"policy_class\":{\"type\":\"string\",\"enum\":[\"NORMAL\",\"EXCEPTION\"]},\"policy_sha256\":{\"type\":\"string\",\"pattern\":\"^[a-f0-9]{64}$\"},\"config_sha256\":{\"type\":\"string\",\"pattern\":\"^[a-f0-9]{64}$\"},\"output_schema_sha256\":{\"type\":\"string\",\"pattern\":\"^[a-f0-9]{64}$\"},\"runner_receipt_id\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":256},\"runner_model\":{\"type\":\"string\",\"enum\":[\"gpt-5.6-luna\",\"gpt-5.6-sol\"]},\"runner_reasoning_effort\":{\"type\":\"string\",\"enum\":[\"max\",\"xhigh\"]},\"auth_mode\":{\"type\":\"string\",\"enum\":[\"CHATGPT_SUBSCRIPTION\",\"CLAUDE_SUBSCRIPTION\"]},\"proposals\":{\"type\":\"array\",\"maxItems\":600,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"transaction_id\",\"field\",\"value_json\",\"confidence\",\"reason_code\"],\"properties\":{\"transaction_id\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":256},\"field\":{\"type\":\"string\",\"enum\":[\"vendor\",\"category\",\"subcategory\",\"tags\",\"evidence_policy\",\"review_required\",\"category_recommendation\",\"is_subscription\",\"property_code\",\"rental_unit\",\"channel\",\"reward_bucket\",\"rule_recommendation\"]},\"value_json\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096},\"confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"reason_code\":{\"type\":\"string\",\"pattern\":\"^[A-Z0-9_:-]{0,128}$\"}}}}}}",
          "streamProgress": false,
          "timeoutSeconds": 180
        }
      }
    },
