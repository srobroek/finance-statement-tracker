      "parameters": {
        "jsCode": "// Purpose: Open Configured Cycle Window. Keep this deterministic and fail closed.\nconst now = new Date();\nconst cycleDay = 1, deadlineDays = 5;\nconst day = now.getDate();\nif (day < cycleDay || day > cycleDay + deadlineDays)\n    return [];\nconst upper = now.toISOString();\nconst start = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, cycleDay));\nreturn [{ json: { run_id: `EI_AMAZON:${upper}`, source_code: 'EI_AMAZON', window_start: start.toISOString(), run_upper_bound: upper, cycle_day: cycleDay, deadline_at: new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), cycleDay + deadlineDays, 23, 59, 59)).toISOString(), period_key: `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}`, trigger_kind: 'SCHEDULE' } }];\n"
      }
    },
    {
