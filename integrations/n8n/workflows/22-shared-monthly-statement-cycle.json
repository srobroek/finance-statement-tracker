        "jsCode": "// Purpose: Select Verified Monthly Statement. Keep this deterministic and fail closed.\n// Purpose: Select Verified Monthly Statement. Fail before any financial write on ambiguous PDFs.\nconst archive = $json;\nif (archive.archive_ready !== true || archive.receipt_readback_verified !== true\n    || archive.attachment_verification_barrier !== 'VERIFIED' || archive.pagination_exhausted !== true)\n    throw new Error('MONTHLY_ARCHIVE_READBACK_REQUIRED');\nconst proofs = archive.attachment_archive_proof;\nif (!Array.isArray(proofs) || !Array.isArray(archive.attachment_identity_keys))\n    throw new Error('MONTHLY_ATTACHMENT_PROOFS_REQUIRED');\nconst identities = proofs.map(row => row.attachment_identity).sort();\nif (new Set(identities).size !== identities.length\n    || JSON.stringify(identities) !== JSON.stringify(archive.attachment_identity_keys.slice().sort()))\n    throw new Error('MONTHLY_ATTACHMENT_PROOF_COVERAGE_MISMATCH');\nfor (const row of proofs) {\n    if (!row.source_message_id || !row.source_attachment_id\n        || row.attachment_identity !== row.source_message_id + ':' + row.source_attachment_id\n        || !/^[a-f0-9]{64}$/.test(String(row.document_sha256 || '')) || !row.onedrive_item_id\n        || typeof row.is_pdf !== 'boolean' || typeof row.is_inline !== 'boolean')\n        throw new Error('MONTHLY_ATTACHMENT_PROOF_INVALID');\n}\nconst candidates = proofs.filter(row => row.is_pdf && !row.is_inline);\nconst hashes = new Set(candidates.map(row => row.document_sha256));\nif (hashes.size > 1)\n    throw new Error('MONTHLY_STATEMENT_AMBIGUOUS_DISTINCT_PDFS_REVIEW_REQUIRED');\nconst selected = candidates.slice().sort((a, b) => a.attachment_identity.localeCompare(b.attachment_identity))[0];\nreturn [{ json: { ...archive, monthly_statement: selected || null,\n            monthly_statement_source_identities: candidates.map(row => row.attachment_identity).sort(),\n            onedrive_item_id: selected?.onedrive_item_id || null } }];\n"
