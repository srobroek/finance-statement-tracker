{
  "schema_version": 1,
  "n8n_version": "2.35.3",
  "timezone": "Asia/Dubai",
  "deployment_mode": "regular-postgres-external-runners",
  "mcp": {
    "enabled": true,
    "allowed_workflow_codes": [
      "OUTLOOK_FINANCE_ACQUISITION",
      "FINANCE_OPERATIONS_STATUS",
      "INTERACTIVE_ARTIFACT_HANDOFF",
      "DOCUMENT_EXTRACTION_REQUEST"
    ]
  },
  "workflows": [
    {
      "code": "OUTLOOK_FINANCE_ACQUISITION",
      "file": "01-outlook-finance-acquisition.json",
      "status": "SHADOW",
      "schedule": null,
      "source": "config/statement-sources.json and config/transaction-email-sources.json",
      "mcp_exposed": true,
      "writes": ["OneDrive evidence archive", "operational source receipt"]
    },
    {
      "code": "RAKBANK_LIVE_CASHBACK",
      "file": "02-rakbank-live-cashback.json",
      "status": "SHADOW",
      "schedule": "FREQ=DAILY;BYHOUR=8;BYMINUTE=5",
      "source": "RAKBANK_CARD_TRANSACTION",
      "replaces_codex_automation": "rakbank-morning-cashback-scan",
      "mcp_exposed": false,
      "writes": ["cashback event store", "outlook:rakbank cursor"]
    },
    {
      "code": "SHARED_STATEMENT_PIPELINE",
      "file": "03-shared-statement-pipeline.json",
      "status": "SHADOW",
      "schedule": null,
      "source": "config/statement-sources.json",
      "mcp_exposed": false,
      "writes": ["Actual", "OneDrive evidence catalogue", "card-period reconciliation"]
    },
    {
      "code": "EI_MONTHLY_STATEMENT",
      "file": "04-ei-monthly-statement.json",
      "status": "SHADOW",
      "schedule": "FREQ=MONTHLY;BYMONTHDAY=1;BYHOUR=20;BYMINUTE=40",
      "source": "EI_AMAZON",
      "replaces_codex_automation": "emirates-islamic-amazon-monthly-statement-reconciliation",
      "mcp_exposed": false,
      "writes": ["Actual", "EI_AMAZON cashback close"]
    },
    {
      "code": "WIO_MONTHLY_STATEMENT",
      "file": "05-wio-monthly-statement.json",
      "status": "SHADOW",
      "schedule": "FREQ=MONTHLY;BYMONTHDAY=3;BYHOUR=20;BYMINUTE=40",
      "source": "WIO_CREDIT",
      "replaces_codex_automation": "wio-monthly-statement-ingestion",
      "mcp_exposed": false,
      "writes": ["Actual"]
    },
    {
      "code": "RAK_MONTHLY_STATEMENT",
      "file": "06-rak-monthly-statement.json",
      "status": "PAUSED",
      "schedule": "FREQ=MONTHLY;BYMONTHDAY=6;BYHOUR=20;BYMINUTE=0",
      "source": "RAK_WORLD",
      "replaces_codex_automation": "rakbank-world-monthly-statement-reconciliation",
      "mcp_exposed": false,
      "writes": ["Actual", "RAK_WORLD cashback close"],
      "blockers": ["VERIFIED_STATEMENT_FIXTURE_REQUIRED", "ACTIVE_ADAPTER_REQUIRED"]
    },
    {
      "code": "SC_MONTHLY_STATEMENT",
      "file": "07-sc-monthly-statement.json",
      "status": "PAUSED",
      "schedule": "FREQ=MONTHLY;BYMONTHDAY=6;BYHOUR=20;BYMINUTE=20",
      "source": "SC_PLATINUM_X",
      "replaces_codex_automation": "standard-chartered-platinum-x-monthly-statement-reconciliation",
      "mcp_exposed": false,
      "writes": ["Actual", "SC_PLATINUM_X cashback close"],
      "blockers": ["VERIFIED_STATEMENT_FIXTURE_REQUIRED", "ACTIVE_ADAPTER_REQUIRED"]
    },
    {
      "code": "SC_LIVE_CASHBACK",
      "file": "08-sc-live-cashback.json",
      "status": "PAUSED",
      "schedule": "FREQ=DAILY;BYHOUR=8;BYMINUTE=25",
      "source": "STANDARD_CHARTERED_CARD_TRANSACTION",
      "replaces_codex_automation": "standard-chartered-morning-cashback-scan",
      "mcp_exposed": false,
      "writes": ["cashback event store", "outlook:standard-chartered cursor"],
      "blockers": ["ACTIVE_EMAIL_SOURCE_REQUIRED", "VERIFIED_MESSAGE_FIXTURE_REQUIRED"]
    },
    {
      "code": "AI_PROPOSAL",
      "file": "09-ai-proposal.json",
      "status": "SHADOW",
      "schedule": null,
      "source": "config/ai-policies.json",
      "mcp_exposed": false,
      "writes": ["review proposal only"]
    },
    {
      "code": "FINANCE_OPERATIONS_STATUS",
      "file": "10-finance-operations-status.json",
      "status": "SHADOW",
      "schedule": "FREQ=DAILY;BYHOUR=8;BYMINUTE=45",
      "source": "n8n executions and operational state",
      "mcp_exposed": true,
      "writes": ["operations alert only"]
    },
    {
      "code": "INTERACTIVE_ARTIFACT_HANDOFF",
      "file": "11-interactive-artifact-handoff.json",
      "status": "SHADOW",
      "schedule": null,
      "source": "reviewed FAB, Sarwa, or Amazon browser artifact",
      "mcp_exposed": true,
      "writes": ["OneDrive evidence archive", "shared deterministic pipeline"]
    },
    {
      "code": "OUTLOOK_MESSAGE_SWEEP",
      "file": "12-outlook-message-sweep.json",
      "status": "SHADOW",
      "schedule": null,
      "source": "config/transaction-email-sources.json",
      "mcp_exposed": false,
      "writes": []
    },
    {
      "code": "DOCUMENT_EXTRACTION_REQUEST",
      "file": "13-document-extraction-request.json",
      "status": "SHADOW",
      "schedule": null,
      "source": "finance_document_operations",
      "mcp_exposed": true,
      "writes": ["document extraction attempt and typed receipt"]
    },
    {
      "code": "LOCAL_PDF_EXTRACTION",
      "file": "14-local-pdf-extraction.json",
      "status": "SHADOW",
      "schedule": null,
      "source": "staged immutable PDF",
      "mcp_exposed": false,
      "writes": ["ephemeral decrypted binary and extraction result"]
    },
    {
      "code": "OPERATIONS_ERROR_HANDLER",
      "file": "16-operations-error-handler.json",
      "status": "SHADOW",
      "schedule": null,
      "source": "n8n workflow error events",
      "mcp_exposed": false,
      "writes": ["durable redacted failure receipt"]
    }
  ],
  "retired_or_not_migrated": [
    {
      "source": "ADCB_CASHBACK",
      "reason": "closed historical card; reconcile balance to zero and do not schedule recurring ingestion"
    }
  ]
}
