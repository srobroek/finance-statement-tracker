{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srobroek/finance-statement-tracker/schemas/cashback-state-v1.json",
  "title": "Cashback notification runtime state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipts",
    "periods",
    "memberships",
    "accounting",
    "category_assessments",
    "fx_snapshots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statementReceipt"
      }
    },
    "periods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/period"
      }
    },
    "memberships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/membership"
      }
    },
    "accounting": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/accounting"
      }
    },
    "category_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/categoryAssessment"
      }
    },
    "fx_snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fxSnapshot"
      }
    }
  },
  "$defs": {
    "nonNegativeMoney": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?:0|[0-9]+(?:\\.[0-9]+)?)$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "statementReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "source_identity",
        "card_code",
        "original_received_at"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "card_code": {
          "type": "string",
          "minLength": 1
        },
        "original_received_at": {
          "type": "string",
          "format": "date-time"
        },
        "period_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_id",
        "card_code",
        "period_start",
        "period_end",
        "status"
      ],
      "properties": {
        "period_id": {
          "type": "string",
          "minLength": 1
        },
        "card_code": {
          "type": "string",
          "minLength": 1
        },
        "period_start": {
          "type": "string",
          "format": "date-time"
        },
        "period_end": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "closed_by_receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "CLOSED"
              }
            }
          },
          "then": {
            "required": [
              "closed_by_receipt_id"
            ],
            "properties": {
              "closed_by_receipt_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "closed_by_receipt_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_code",
        "coverage",
        "sc_held"
      ],
      "properties": {
        "card_code": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "enum": [
            "HELD",
            "NOT_HELD",
            "UNKNOWN"
          ]
        },
        "sc_held": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "HELD"
              }
            }
          },
          "then": {
            "properties": {
              "sc_held": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "NOT_HELD"
              }
            }
          },
          "then": {
            "properties": {
              "sc_held": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "sc_held": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_id",
        "card_code",
        "qualifying_spend",
        "refund_deductions",
        "consumed_cap_headroom"
      ],
      "properties": {
        "period_id": {
          "type": "string",
          "minLength": 1
        },
        "card_code": {
          "type": "string",
          "minLength": 1
        },
        "qualifying_spend": {
          "$ref": "#/$defs/nonNegativeMoney"
        },
        "refund_deductions": {
          "$ref": "#/$defs/nonNegativeMoney"
        },
        "consumed_cap_headroom": {
          "$ref": "#/$defs/nonNegativeMoney"
        }
      }
    },
    "categoryAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "status",
        "review_required"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "review_required": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "RESOLVED"
              }
            }
          },
          "then": {
            "required": [
              "category"
            ],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNRESOLVED"
              }
            }
          },
          "then": {
            "properties": {
              "review_required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "fxSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "snapshot_id",
        "provider",
        "base_currency",
        "quote_currency",
        "observed_at",
        "quote_date",
        "quote_basis",
        "rate",
        "precision",
        "max_age_seconds",
        "source_identity",
        "uncertainty"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "base_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "quote_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "quote_date": {
          "type": "string",
          "format": "date"
        },
        "quote_basis": {
          "enum": [
            "BASE_PER_QUOTE",
            "QUOTE_PER_BASE"
          ]
        },
        "rate": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "enum": [
            "KNOWN",
            "ESTIMATE",
            "UNKNOWN"
          ]
        }
      }
    }
  }
}
