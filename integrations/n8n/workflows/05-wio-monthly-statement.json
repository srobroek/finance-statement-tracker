        "jsCode": "// Purpose: Restore Enumeration Request After Cursor Init. Keep this deterministic and fail closed.\nconst source = $('Assemble Trusted Acquisition Contract').first().json, initialization = $json;\nif (!['CURSOR_INITIALIZED', 'CURSOR_ALREADY_INITIALIZED'].includes(initialization.status) || initialization.readback_verified !== true)\n    throw new Error('SOURCE_CURSOR_INITIALIZATION_TERMINAL_READBACK_REQUIRED');\nreturn [{ json: { ...source, operation: 'ENUMERATE', cursor_initialization_status: initialization.status, cursor_initialization_version: Number(initialization.cursor_version) } }];\n"
