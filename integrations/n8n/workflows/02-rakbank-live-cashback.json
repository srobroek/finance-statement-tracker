      "parameters": {
        "jsCode": "// Purpose: Freeze Cursor Minus Overlap Window. Keep this deterministic and fail closed.\nconst upper = new Date();\nconst saved = $json.ingest_state?.cursor;\nconst cursor = saved ? new Date(saved) : new Date(upper.getTime() - 26 * 3600000);\nif (cursor > upper)\n    throw new Error('Durable cursor is after run upper bound');\nconst start = new Date(cursor.getTime() - 2 * 3600000);\nconst run_upper_bound = upper.toISOString();\nreturn [{ json: { run_id: `RAKBANK_CARD_TRANSACTION:${run_upper_bound}`, source_code: 'RAKBANK_CARD_TRANSACTION', cursor_key: 'outlook:rakbank', window_start: start.toISOString(), run_upper_bound } }];\n"
