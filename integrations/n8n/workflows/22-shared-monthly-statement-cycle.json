        "jsCode": "// Purpose: Verify W12 COMMIT Terminal Readback. Keep this deterministic and fail closed.\nconst request = $('Build W12 COMMIT Request').first().json, result = $json;\nif (result.status !== 'CURSOR_COMMITTED' || result.run_id !== request.run_id || result.source_code !== request.source_code || result.cursor !== request.run_upper_bound || Number(result.cursor_version) !== Number(request.expected_cursor_version) + 1 || result.downstream_receipt_sha256 !== request.downstream_receipt_sha256)\n    throw new Error('SOURCE_CURSOR_COMMIT_TERMINAL_READBACK_MISMATCH');\nreturn [{ json: { ...request, ...result, terminal_readback_verified: true, status: 'COMMITTED' } }];\n"
