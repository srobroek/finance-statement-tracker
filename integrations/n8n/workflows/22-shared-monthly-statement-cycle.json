        "jsCode": "// Purpose: Assemble Immutable Pipeline Input. Keep this deterministic and fail closed.\n// Purpose: Assemble Immutable Pipeline Input. Bind the selected archived PDF to this cycle.\nconst c = $('Assemble Trusted Acquisition Contract').first().json;\nconst r = $('Select Verified Monthly Statement').first().json;\nconst proof = r.monthly_statement;\nif (!proof || $json.monthly_download_sha256 !== proof.document_sha256)\n    throw new Error('MONTHLY_DOWNLOADED_STATEMENT_HASH_MISMATCH');\nreturn [{ json: { ...c, ...r, document_sha256: proof.document_sha256,\n            onedrive_item_id: proof.onedrive_item_id, message_id: proof.source_message_id,\n            source_message_id: proof.source_message_id, attachment_id: proof.source_attachment_id,\n            source_attachment_id: proof.source_attachment_id }, binary: $binary }];\n"
