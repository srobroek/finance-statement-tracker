      "parameters": {
        "jsCode": "// Purpose: Build OPEN Provider Circuit. Keep this deterministic and fail closed.\nconst failure = $('Redact and Classify Failure').first().json, row = $json?.provider_code ? $json : {}, count = Math.min(12, Number(row.transient_failure_count || 0) + 1), seconds = Math.min(3600, 60 * (2 ** Math.min(count - 1, 6))), now = new Date();\nreturn [{ json: { provider_code: failure.provider_code, state: 'OPEN', transient_failure_count: count, last_error_class: failure.error_class, opened_at: now.toISOString(), retry_after: new Date(now.getTime() + seconds * 1000).toISOString(), readback_verified: false, updated_at: now.toISOString() } }];\n"
