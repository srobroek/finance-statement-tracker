[
  {
    "schema_version": 1,
    "rule_id": "normalize-card-payment",
    "name": "Card payment transfer",
    "stage": "TRANSACTION_NORMALIZATION",
    "priority": 10,
    "match": {
      "any": [
        {
          "all": [
            {
              "field": "transaction_type",
              "operator": "equals",
              "value": "PAYMENT"
            }
          ]
        },
        {
          "all": [
            {
              "field": "merchant_raw",
              "operator": "contains_any",
              "value": [
                "PAYMENT RECEIVED",
                "CARD PAYMENT",
                "AUTOPAY PAYMENT"
              ]
            }
          ]
        }
      ]
    },
    "actions": [
      {
        "action": "set",
        "field": "transaction_type",
        "value": "TRANSFER",
        "sequence": 10
      },
      {
        "action": "set_if_empty",
        "field": "category",
        "value": "Card Payments",
        "sequence": 20
      },
      {
        "action": "add_tags",
        "value": [
          "transfer",
          "card-payment"
        ],
        "sequence": 30
      }
    ],
    "stop_on_match": true,
    "rule_sets": ["FULL_LEDGER"]
  },
  {
    "schema_version": 1,
    "rule_id": "normalize-cashback-credit",
    "name": "Cashback and reward credit",
    "stage": "TRANSACTION_NORMALIZATION",
