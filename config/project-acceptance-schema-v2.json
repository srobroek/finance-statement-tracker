{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-acceptance-schema-v2",
  "type": "object",
  "required": ["schema_version", "generated_at", "environment", "requirements"],
  "properties": {
    "schema_version": {"const": 2},
    "generated_at": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "required": ["id", "git_commit", "actual_sync_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "git_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "actual_sync_id": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "invariant", "status", "production_gate", "verifier",
          "dependencies", "evidence", "blockers"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "invariant": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "SPEC_ONLY", "IMPLEMENTED_NOT_DEPLOYED", "TESTED_IN_DISPOSABLE",
              "SHADOW", "PRODUCTION", "VERIFIED", "PARTIAL", "BLOCKED",
              "MISSING", "SUPERSEDED"
            ]
          },
          "production_gate": {"type": "boolean"},
          "verifier": {
            "type": "object",
            "required": ["kind", "command", "expected"],
            "properties": {
              "kind": {"enum": ["TEST", "SCRIPT", "RUNTIME_READBACK", "MANUAL_REVIEW"]},
              "command": {"type": "string", "minLength": 1},
              "expected": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "artifact_uri", "sha256", "observed_at", "expires_at",
                "environment_id", "actual_sync_id", "git_commit", "reviewer",
                "non_empty"
              ],
              "properties": {
                "artifact_uri": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "observed_at": {"type": "string", "format": "date-time"},
                "expires_at": {"type": ["string", "null"], "format": "date-time"},
                "environment_id": {"type": "string", "minLength": 1},
                "actual_sync_id": {"type": ["string", "null"], "minLength": 1},
                "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "reviewer": {"type": "string", "minLength": 1},
                "non_empty": {"const": true}
              },
              "additionalProperties": false
            }
          },
          "blockers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
