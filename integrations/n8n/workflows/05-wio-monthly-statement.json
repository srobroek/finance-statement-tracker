    {
      "id": "5002",
      "name": "Open Configured Cycle Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -820,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Open Configured Cycle Window. Keep this deterministic and fail closed.\nconst now = new Date();\nconst cycleDay = 3, deadlineDays = 5;\nconst day = now.getDate();\nif (day < cycleDay || day > cycleDay + deadlineDays)\n    return [];\nconst upper = now.toISOString();\nconst start = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, cycleDay));\nreturn [{ json: { run_id: `WIO_CREDIT:${upper}`, source_code: 'WIO_CREDIT', window_start: start.toISOString(), run_upper_bound: upper, cycle_day: cycleDay, deadline_at: new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), cycleDay + deadlineDays, 23, 59, 59)).toISOString(), period_key: `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}`, trigger_kind: 'SCHEDULE' } }];\n"
      }
    },
    {
      "id": "5003",
      "name": "Load Trusted Source Contract",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -520,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "finance_source_contracts",
          "mode": "name"
        },
        "returnAll": false,
        "limit": 1,
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "source_code",
              "condition": "eq",
              "keyValue": "WIO_CREDIT"
            },
            {
              "keyName": "enabled",
              "condition": "eq",
              "keyValue": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5004",
      "name": "Assemble Trusted Acquisition Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Assemble Trusted Acquisition Contract. Keep this deterministic and fail closed.\nconst w = $('Open Configured Cycle Window').first().json, c = $json;\nreturn [{ json: { ...w, ...c, operation: 'ENUMERATE', senders: JSON.parse(c.senders_json), subjects: JSON.parse(c.subjects_json) } }];\n"
      }
    },
