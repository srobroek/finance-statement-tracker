{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxsan.com/schemas/finance-workflow-parameter-ownership-v1.json",
  "title": "Finance n8n workflow parameter ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_status",
    "parameter_node_types",
    "workflow_globs",
    "global_contract_sources",
    "credential_identifier_sources",
    "forbidden",
    "workflows"
  ],
  "properties": {
    "$schema": {"const": "https://vxsan.com/schemas/finance-workflow-parameter-ownership-v1.json"},
    "schema_version": {"const": 1},
    "contract_status": {"const": "SPEC_ONLY"},
    "parameter_node_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "workflow_globs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "global_contract_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "selectors"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "selectors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "credential_identifier_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "selectors"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "selectors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_key_patterns",
        "secret_value_patterns",
        "protected_field_names"
      ],
      "properties": {
        "credential_key_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "secret_value_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "protected_field_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "workflows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodes"],
        "properties": {
          "nodes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["caller_fields", "fields"],
              "properties": {
                "caller_fields": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "fields": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["category", "type"],
                    "properties": {
                      "category": {
                        "enum": [
                          "global_generated_contract",
                          "workflow_local_input",
                          "workflow_local_constant",
                          "derived_state"
                        ]
                      },
                      "type": {
                        "enum": ["string", "number", "boolean", "array", "object"]
                      },
                      "expression_allowed": {"type": "boolean"},
                      "duplicate_literal_allowed": {"type": "boolean"},
                      "source": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["path", "selector"],
                        "properties": {
                          "path": {"type": "string", "minLength": 1},
                          "selector": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
