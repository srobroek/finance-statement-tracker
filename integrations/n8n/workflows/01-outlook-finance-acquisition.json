      "id": "10000000-0000-4000-8000-000000000103",
      "name": "Validate Bounded Source Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-650, 0],
      "parameters": {
        "jsCode": "const r = $json; const required = ['run_id','source_code','folder_id','senders','subjects','window_start','run_upper_bound']; for (const k of required) if (r[k] === undefined || r[k] === null || r[k] === '') throw new Error(`Missing trusted contract field ${k}`); if (!Array.isArray(r.senders) || !Array.isArray(r.subjects) || !r.senders.length || !r.subjects.length) throw new Error('Trusted sender and subject allowlists are required'); const start = new Date(r.window_start); const upper = new Date(r.run_upper_bound); if (!(start < upper) || upper > new Date()) throw new Error('Acquisition window must be positive and frozen no later than now'); return [{json:{...r, window_end:upper.toISOString(), senders:r.senders.map(v=>String(v).toLowerCase()), subjects:r.subjects.map(String)}}];"
      }
    },
