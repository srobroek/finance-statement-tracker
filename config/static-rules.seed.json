          ]
        }
      ]
    },
    "actions": [
      {
        "action": "set",
        "field": "transaction_type",
        "value": "REWARD_CREDIT"
      },
      {
        "action": "set_if_empty",
        "field": "category",
        "value": "Cashback & Rewards",
        "sequence": 20
      },
      {
        "action": "add_tag",
        "value": "reward",
        "sequence": 30
      }
    ],
    "stop_on_match": true,
    "rule_sets": ["FULL_LEDGER"]
  },
  {
    "schema_version": 1,
    "rule_id": "normalize-refund",
    "name": "Explicit refund or reversal",
    "stage": "TRANSACTION_NORMALIZATION",
    "priority": 30,
    "match": {
      "any": [
        {
          "all": [
            {
              "field": "merchant_raw",
              "operator": "regex",
              "value": "\\b(REFUND|REVERSAL|REVERSED)\\b"
            }
          ]
        }
      ]
    },
    "actions": [
      {
        "action": "set",
        "field": "transaction_type",
        "value": "REFUND"
      },
      {
        "action": "set_if_empty",
        "field": "category",
        "value": "Refunds & Reimbursements",
        "sequence": 20
      },
      {
        "action": "add_tag",
        "value": "refund",
        "sequence": 30
      }
    ],
    "stop_on_match": true,
    "rule_sets": [
      "FULL_LEDGER",
      "LIVE_CASHBACK"
    ]
  },
