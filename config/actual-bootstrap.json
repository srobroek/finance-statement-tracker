  "rules": [
    {
      "name": "[guard:card-payment-sign] Incoming credit-card payments are inflows",
      "stage": "pre",
      "conditionsOp": "and",
      "conditions": [
        {
          "field": "account",
          "op": "oneOf",
          "value": [
            {"ref": "account", "name": "ADCB Credit Card · 8833 / 6838"},
            {"ref": "account", "name": "Emirates Islamic Amazon Credit Card · 0082"},
            {"ref": "account", "name": "FAB Credit Card · 6031"},
            {"ref": "account", "name": "RAKBANK World Credit Card"},
            {"ref": "account", "name": "Standard Chartered Platinum X Credit Card"},
            {"ref": "account", "name": "Wio Credit Card · 4113 / 5009"}
          ]
        },
        {
          "field": "imported_payee",
          "op": "matches",
          "value": "(?:payment received|credit repayment|card repayment)"
        }
      ],
      "actions": [
        {
          "field": "amount",
          "op": "set",
          "value": null,
          "options": {"formula": "=ABS(amount / 100)"}
        }
      ]
    },
    {
      "name": "[loan:ADIB_BLUEWATERS_B7_306] Split payment into interest and principal",
      "enabled": false,
      "activation_requirements": [
        "Enable the Abu Dhabi Islamic Bank mortgage account.",
        "Replace __LOAN_START_DATE__ with the exact contractual start date in both formulas.",
        "Confirm the imported payment description matches the configured regex."
      ],
      "stage": "pre",
      "conditionsOp": "and",
      "conditions": [
        {
          "field": "imported_payee",
          "op": "matches",
          "value": "(?:adib|abu dhabi islamic).*(?:mortgage|home finance)|(?:mortgage|home finance).*(?:adib|abu dhabi islamic)"
        },
        {"field": "amount", "op": "lt", "value": 0}
      ],
      "actions": [
        {
          "op": "set-split-amount",
          "value": null,
          "options": {
            "splitIndex": 1,
            "method": "formula",
            "formula": "=-ROUND(ABS(IPMT(0.0399/12, DATEDIF(\"__LOAN_START_DATE__\", date, \"M\") + 1, 240, -2600000)), 2)"
          }
        },
        {
          "field": "category",
          "op": "set",
          "value": {"ref": "category", "name": "Mortgage Interest"},
          "options": {"splitIndex": 1}
        },
        {
          "op": "prepend-notes",
          "value": "#home #mortgage ",
          "options": {"splitIndex": 1}
        },
        {
          "op": "set-split-amount",
          "value": null,
          "options": {
            "splitIndex": 2,
            "method": "formula",
            "formula": "=-ROUND(ABS(PPMT(0.0399/12, DATEDIF(\"__LOAN_START_DATE__\", date, \"M\") + 1, 240, -2600000)), 2)"
          }
        },
        {
          "field": "payee",
          "op": "set",
          "value": {"ref": "payee", "name": "Abu Dhabi Islamic Bank Mortgage · Bluewaters B7-306"},
          "options": {"splitIndex": 2}
        },
        {
          "op": "prepend-notes",
          "value": "#home #mortgage ",
          "options": {"splitIndex": 2}
        },
        {
          "op": "set-split-amount",
          "value": null,
          "options": {"splitIndex": 3, "method": "remainder"}
        },
        {
          "field": "category",
          "op": "set",
          "value": {"ref": "category", "name": "Needs Review"},
          "options": {"splitIndex": 3}
        },
        {
          "op": "prepend-notes",
          "value": "#home #mortgage #needs-review | Review: mortgage-payment-variance",
          "options": {"splitIndex": 3}
        }
      ]
    }
  ],
