    {"id":"10010","name":"Validate Bounded MCP Dispatch","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1000,100],"parameters":{"jsCode":"const r=$json,allowed=new Set(['finance.status','artifact.submit_reviewed','document.request']),op=String(r.operation_code||''); if(!allowed.has(op)) throw new Error('MCP_OPERATION_NOT_ALLOWED'); const request_id=String(r._mcp_request_id||''); if(!/^[A-Za-z0-9:_-]{1,128}$/.test(request_id)) throw new Error('MCP_REQUEST_ID_INVALID'); const specs={ 'finance.status':[], 'artifact.submit_reviewed':['artifact_id','expected_sha256'], 'document.request':['document_id','expected_sha256','document_profile','requested_schema_version']},args={}; for(const key of specs[op]){const value=String(r[key]||''); if(!value||value.length>256) throw new Error(`MCP_ARGUMENT_INVALID:${key}`); args[key]=value;} if(args.expected_sha256&&!/^[a-f0-9]{64}$/.test(args.expected_sha256)) throw new Error('MCP_HASH_INVALID'); const target={ 'finance.status':'FINANCE_OPERATIONS_STATUS', 'artifact.submit_reviewed':'INTERACTIVE_ARTIFACT_HANDOFF', 'document.request':'DOCUMENT_EXTRACTION_REQUEST'}[op]; return [{json:{request_id,operation_code:op,target_workflow_code:target,args,request_canonical:JSON.stringify({operation_code:op,args})}}];"}},
