{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxsan.com/schemas/finance-ai-proposal-v1.json",
  "title": "Finance AI proposal-only result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "idempotency_key", "agent_provider", "policy_id", "policy_class",
    "policy_sha256", "config_sha256", "output_schema_sha256", "runner_receipt_id",
    "runner_model", "runner_reasoning_effort", "auth_mode", "proposals"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "job_id": {"type": "string", "pattern": "^finance-ai:[a-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agent_provider": {"type": "string", "enum": ["CODEX_SUBSCRIPTION"]},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]{0,127}$"},
    "policy_class": {"type": "string", "enum": ["NORMAL", "EXCEPTION"]},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runner_receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "runner_model": {"type": "string", "enum": ["gpt-5.6-luna", "gpt-5.6-sol"]},
    "runner_reasoning_effort": {"type": "string", "enum": ["xhigh"]},
    "auth_mode": {"type": "string", "enum": ["CHATGPT_SUBSCRIPTION"]},
    "proposals": {
      "type": "array",
      "maxItems": 600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transaction_id", "field", "value", "confidence", "reason_code"],
        "properties": {
          "transaction_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "field": {
            "type": "string",
            "enum": [
              "vendor", "category", "subcategory", "tags", "evidence_policy",
              "review_required", "category_recommendation", "is_subscription",
              "property_code", "rental_unit", "channel", "reward_bucket",
              "rule_recommendation"
            ]
          },
          "value": {},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason_code": {"type": "string", "pattern": "^[A-Z0-9_:-]{0,128}$"}
        },
        "oneOf": [
          {
            "properties": {
              "field": {
                "enum": [
                  "vendor", "category", "subcategory", "evidence_policy",
                  "property_code", "rental_unit", "channel", "reward_bucket"
                ]
              },
              "value": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          },
          {
            "properties": {
              "field": {"const": "tags"},
              "value": {
                "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
                "items": {
                  "type": "string", "minLength": 1, "maxLength": 64,
                  "pattern": "^[a-z0-9:_-]+$"
                }
              }
            }
          },
          {
            "properties": {
              "field": {"enum": ["review_required", "is_subscription"]},
              "value": {"type": "boolean"}
            }
          },
          {
            "properties": {
              "field": {"const": "category_recommendation"},
              "value": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "group", "reason"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 80},
                  "group": {"type": "string", "minLength": 1, "maxLength": 80},
                  "reason": {"type": "string", "minLength": 1, "maxLength": 300}
                }
              }
            }
          },
          {
            "properties": {
              "field": {"const": "rule_recommendation"},
              "value": {
                "type": "object", "additionalProperties": false,
                "required": ["enabled", "evidence_count"],
                "properties": {
                  "enabled": {"const": false},
                  "evidence_count": {"type": "integer", "minimum": 3, "maximum": 10000}
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "agent_provider": {"const": "CODEX_SUBSCRIPTION"},
            "policy_class": {"const": "NORMAL"},
            "runner_model": {"const": "gpt-5.6-luna"},
            "runner_reasoning_effort": {"const": "xhigh"},
            "auth_mode": {"const": "CHATGPT_SUBSCRIPTION"}
          }
        },
        {
          "properties": {
            "agent_provider": {"const": "CODEX_SUBSCRIPTION"},
            "policy_class": {"const": "EXCEPTION"},
            "runner_model": {"const": "gpt-5.6-sol"},
            "runner_reasoning_effort": {"const": "xhigh"},
            "auth_mode": {"const": "CHATGPT_SUBSCRIPTION"}
          }
        }
      ]
    }
  ]
}
