    {
      "id": "21003",
      "name": "Validate and Build Fixed Provider Invocation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Validate and Build Fixed Provider Invocation. Keep this deterministic and fail closed.\nconst job = $json;\nif (!job.job_id || !/^finance-email:[a-f0-9]{64}$/.test(String(job.job_id)))\n    throw new Error('EMAIL_ENRICHMENT_JOB_ID_INVALID');\nif (!/^[a-f0-9]{64}$/.test(String(job.idempotency_key || '')))\n    throw new Error('EMAIL_ENRICHMENT_IDEMPOTENCY_KEY_INVALID');\nif (job.agent_provider !== 'CODEX_SUBSCRIPTION' || job.policy_class !== 'NORMAL' || job.codex_auth_mode !== 'CHATGPT_SUBSCRIPTION')\n    throw new Error('PRODEX_POLICY_NOT_SERVER_OWNED');\nif (job.codex_model !== 'gpt-5.6-luna' || job.codex_reasoning_effort !== 'max')\n    throw new Error('PRODEX_MODEL_POLICY_MISMATCH');\nif (!Array.isArray(job.matched) || !job.matched.length || job.matched.length > 100)\n    throw new Error('EMAIL_ENRICHMENT_MATCH_BATCH_INVALID');\nfor (const match of job.matched) {\n    if (!match?.transaction_id || !match?.replay_key || !match.identity?.source_message_id || !match.facts?.merchant || match.body || match.body_preview || match.raw_message)\n        throw new Error('EMAIL_ENRICHMENT_EVIDENCE_NOT_REDACTED');\n}\nconst unresolved = Array.isArray(job.unresolved) ? job.unresolved : [];\nconst request = {\n    schema_version: 1, operation_code: 'EMAIL_ENRICHMENT_EVIDENCE', job_id: job.job_id, idempotency_key: job.idempotency_key,\n    matched: job.matched, unresolved, archive_sha256: job.archive_sha256,\n};\nconst prompt = [\n    'Return only one schema-bound finance proposal envelope.',\n    'This is proposal-only. Do not use tools, browse, read files, write data, or alter immutable transaction facts.',\n    'Use only the redacted Outlook identity and facts supplied below. Echo transaction_id and source_message_id in reason_code context only; never invent an identity.',\n    `Output JSON Schema: ${job.proposal_output_schema}`,\n    `Authoritative evidence handoff: ${JSON.stringify(request)}`,\n].join('\\\\n\\\\n');\nreturn [{ json: { ...job, request, provider_prompt: prompt, provider_model: job.codex_model, provider_reasoning_effort: job.codex_reasoning_effort, provider_auth_mode: job.codex_auth_mode } }];"
      }
    },
    {
      "id": "21005",
      "name": "Run Codex Subscription Provider",
      "type": "n8n-nodes-prodex.prodex",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ],
      "parameters": {
        "operation": "runAgent",
        "useN8nCredentials": false,
        "systemPrompt": "Finance proposal only. Never use tools or mutate data. Return only the schema-bound JSON proposal.",
        "skills": [],
        "prompt": "={{ $json.provider_prompt }}",
        "model": "={{ $json.provider_model }}",
        "reasoningEffort": "={{ $json.provider_reasoning_effort }}",
        "personality": "pragmatic",
        "threadMode": "new",
        "sandbox": "read_only",
        "workingDirectory": "/tmp/finance-ai",
        "options": {
          "outputSchema": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://vxsan.com/schemas/finance-ai-proposal-v1.json\",\"title\":\"Finance AI proposal-only result\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"schema_version\",\"job_id\",\"idempotency_key\",\"agent_provider\",\"policy_id\",\"policy_class\",\"policy_sha256\",\"config_sha256\",\"output_schema_sha256\",\"runner_receipt_id\",\"runner_model\",\"runner_reasoning_effort\",\"auth_mode\",\"proposals\"],\"properties\":{\"schema_version\":{\"type\":\"integer\",\"const\":1},\"job_id\":{\"type\":\"string\",\"pattern\":\"^finance-ai:[a-f0-9]{64}$\"},\"idempotency_key\":{\"type\":\"string\",\"pattern\":\"^[a-f0-9]{64}$\"},\"agent_provider\":{\"type\":\"string\",\"enum\":[\"CODEX_SUBSCRIPTION\",\"CLAUDE_SUBSCRIPTION\"]},\"policy_id\":{\"type\":\"string\",\"pattern\":\"^[a-z0-9][a-z0-9:_-]{0,127}$\"},\"policy_class\":{\"type\":\"string\",\"enum\":[\"NORMAL\",\"EXCEPTION\"]},\"policy_sha256\":{\"type\":\"string\",\"pattern\":\"^[a-f0-9]{64}$\"},\"config_sha256\":{\"type\":\"string\",\"pattern\":\"^[a-f0-9]{64}$\"},\"output_schema_sha256\":{\"type\":\"string\",\"pattern\":\"^[a-f0-9]{64}$\"},\"runner_receipt_id\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":256},\"runner_model\":{\"type\":\"string\",\"enum\":[\"gpt-5.6-luna\",\"gpt-5.6-sol\",\"claude-sonnet-4-6\"]},\"runner_reasoning_effort\":{\"type\":\"string\",\"enum\":[\"max\",\"medium\",\"default\"]},\"auth_mode\":{\"type\":\"string\",\"enum\":[\"CHATGPT_SUBSCRIPTION\",\"CLAUDE_SUBSCRIPTION\"]},\"proposals\":{\"type\":\"array\",\"maxItems\":600,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"transaction_id\",\"field\",\"value\",\"confidence\",\"reason_code\"],\"properties\":{\"transaction_id\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":256},\"field\":{\"type\":\"string\",\"enum\":[\"vendor\",\"category\",\"subcategory\",\"tags\",\"evidence_policy\",\"review_required\",\"category_recommendation\",\"is_subscription\",\"property_code\",\"rental_unit\",\"channel\",\"reward_bucket\",\"rule_recommendation\"]},\"value\":{},\"confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"reason_code\":{\"type\":\"string\",\"pattern\":\"^[A-Z0-9_:-]{0,128}$\"}},\"oneOf\":[{\"properties\":{\"field\":{\"enum\":[\"vendor\",\"category\",\"subcategory\",\"evidence_policy\",\"property_code\",\"rental_unit\",\"channel\",\"reward_bucket\"]},\"value\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":128}}},{\"properties\":{\"field\":{\"const\":\"tags\"},\"value\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":12,\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":64,\"pattern\":\"^[a-z0-9:_-]+$\"}}}},{\"properties\":{\"field\":{\"enum\":[\"review_required\",\"is_subscription\"]},\"value\":{\"type\":\"boolean\"}}},{\"properties\":{\"field\":{\"const\":\"category_recommendation\"},\"value\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"name\",\"group\",\"reason\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":80},\"group\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":80},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":300}}}}},{\"properties\":{\"field\":{\"const\":\"rule_recommendation\"},\"value\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"enabled\",\"evidence_count\"],\"properties\":{\"enabled\":{\"const\":false},\"evidence_count\":{\"type\":\"integer\",\"minimum\":3,\"maximum\":10000}}}}}]}}},\"allOf\":[{\"oneOf\":[{\"properties\":{\"agent_provider\":{\"const\":\"CODEX_SUBSCRIPTION\"},\"policy_class\":{\"const\":\"NORMAL\"},\"runner_model\":{\"const\":\"gpt-5.6-luna\"},\"runner_reasoning_effort\":{\"const\":\"max\"},\"auth_mode\":{\"const\":\"CHATGPT_SUBSCRIPTION\"}}},{\"properties\":{\"agent_provider\":{\"const\":\"CODEX_SUBSCRIPTION\"},\"policy_class\":{\"const\":\"EXCEPTION\"},\"runner_model\":{\"const\":\"gpt-5.6-sol\"},\"runner_reasoning_effort\":{\"const\":\"medium\"},\"auth_mode\":{\"const\":\"CHATGPT_SUBSCRIPTION\"}}},{\"properties\":{\"agent_provider\":{\"const\":\"CLAUDE_SUBSCRIPTION\"},\"policy_class\":{\"enum\":[\"NORMAL\",\"EXCEPTION\"]},\"runner_model\":{\"const\":\"claude-sonnet-4-6\"},\"runner_reasoning_effort\":{\"const\":\"default\"},\"auth_mode\":{\"const\":\"CLAUDE_SUBSCRIPTION\"}}}]}]}",
          "streamProgress": false,
          "timeoutSeconds": 180
        }
      }
    },
    {
      "id": "21007",
      "name": "Validate Proposal Schema and Normalize Provider Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Validate Proposal Schema and Normalize Provider Output. Keep this deterministic and fail closed.\nconst invocation = $('Validate and Build Fixed Provider Invocation').first().json;\nconst providerError = String($json?.error?.message || $json?.errorMessage || $json?.message || '');\nif (providerError) {\n    if (/auth|login|credential|token|unauthori|forbidden/i.test(providerError))\n        throw new Error('PRODEX_AUTH_REQUIRED: persistent ChatGPT subscription auth is missing or revoked; run codex login in the n8n auth home');\n    throw new Error('PRODEX_PROVIDER_FAILED: ' + providerError.slice(0, 160));\n}\nlet proposal;\ntry {\n    proposal = typeof $json.output === 'string' ? JSON.parse($json.output) : ($json.output || $json);\n}\ncatch {\n    throw new Error('PRODEX_SCHEMA_OUTPUT_INVALID');\n}\nif (!proposal || typeof proposal !== 'object' || Array.isArray(proposal))\n    throw new Error('PRODEX_SCHEMA_OUTPUT_INVALID');\nconst required = ['schema_version', 'job_id', 'idempotency_key', 'agent_provider', 'policy_id', 'policy_class', 'policy_sha256', 'config_sha256', 'output_schema_sha256', 'runner_receipt_id', 'runner_model', 'runner_reasoning_effort', 'auth_mode', 'proposals'];\nif (Object.keys(proposal).some(field => !required.includes(field)) || required.some(field => proposal[field] === undefined) || proposal.schema_version !== 1 || proposal.job_id !== invocation.job_id || proposal.idempotency_key !== invocation.idempotency_key || proposal.agent_provider !== 'CODEX_SUBSCRIPTION' || proposal.runner_model !== 'gpt-5.6-luna' || proposal.runner_reasoning_effort !== 'max' || proposal.auth_mode !== 'CHATGPT_SUBSCRIPTION' || !Array.isArray(proposal.proposals))\n    throw new Error('EMAIL_ENRICHMENT_PROPOSAL_SCHEMA_INVALID');\nreturn [{ json: { ...proposal, evidence_archive_sha256: invocation.archive_sha256, evidence_replay_keys: invocation.matched.map(match => match.replay_key), readback_verified: false } }];"
      }
    }
  ],
