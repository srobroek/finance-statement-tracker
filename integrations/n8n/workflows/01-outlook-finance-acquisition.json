      "position": [-150, 0],
      "parameters": {
        "jsCode": "const c = $('Validate Bounded Source Request').first().json; return $input.all().filter(i => { const j=i.json; const sender=String(j.from?.emailAddress?.address || j.sender?.emailAddress?.address || '').toLowerCase(); const subject=String(j.subject || ''); const received=new Date(j.receivedDateTime); return c.senders.includes(sender) && c.subjects.includes(subject) && received >= new Date(c.window_start) && received < new Date(c.window_end); }).map(i=>({json:{...i.json, source_code:c.source_code, window_start:c.window_start, window_end:c.window_end}}));"
      }
