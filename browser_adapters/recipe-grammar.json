{
  "schema_version": 1,
  "actions": {
    "GOTO": {"where": "provider", "required": ["url"], "optional": [], "terminal": false},
    "CLICK": {"where": "both", "required": ["selector"], "optional": ["button"], "terminal": false},
    "SELECT": {"where": "both", "required": ["field", "option"], "optional": [], "terminal": false},
    "READ": {"where": "both", "required": ["selector", "as"], "optional": [], "terminal": true},
    "DOWNLOAD": {"where": "both", "required": ["as"], "optional": ["format"], "terminal": true},
    "EXPORT": {"where": "both", "required": ["as"], "optional": ["format"], "terminal": false},
    "UPLOAD": {"where": "both", "required": ["as"], "optional": [], "terminal": true},
    "CONNECTOR_CALL": {"where": "both", "required": ["connector"], "optional": ["as"], "terminal": true},
    "FETCH_EMAIL": {"where": "data", "required": ["subject", "attachment", "as"], "optional": [], "terminal": true},
    "ASSERT": {"where": "both", "required": ["condition"], "optional": [], "terminal": false},
    "NOTE": {"where": "both", "required": [], "optional": [], "terminal": false, "free_text": true}
  },
  "acquire_terminal_map": {
    "download-pdf": "DOWNLOAD",
    "download-csv": "DOWNLOAD",
    "download-xlsx": "DOWNLOAD",
    "upload": "UPLOAD",
    "connector": "CONNECTOR_CALL",
    "read-onscreen": "READ",
    "email": "FETCH_EMAIL"
  },
  "max_consecutive_notes": 2
}
