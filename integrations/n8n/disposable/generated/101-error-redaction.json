        "jsCode": "// Purpose: Verify Durable Failure Receipt. Keep this deterministic and fail closed.\nconst expected = $('Redact and Classify Failure').first().json;\nconst rows = $input.all().map(item => item.json);\nif (rows.length !== 1 || !rows[0].execution_id)\n    throw new Error('FAILURE_RECEIPT_READBACK_COUNT_MISMATCH');\nconst observed = rows[0];\nfor (const field of [\"execution_id\", \"workflow_id\", \"workflow_name\", \"workflow_code\", \"run_id\", \"provider_code\", \"error_class\", \"error_message_redacted\", \"first_seen_at\"]) {\n    const actual = field === 'first_seen_at' ? new Date(observed[field]).toISOString() : observed[field];\n    if (actual !== expected[field])\n        throw new Error('FAILURE_RECEIPT_READBACK_MISMATCH:' + field);\n}\nif (observed.readback_verified !== true)\n    throw new Error('FAILURE_RECEIPT_VERIFIED_MARKER_MISMATCH');\nreturn [{ json: { ...observed, terminal_receipt_sink: 'finance_execution_failures' } }];\n"
