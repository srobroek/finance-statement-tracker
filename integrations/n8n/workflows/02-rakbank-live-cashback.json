      "parameters": {
        "jsCode": "// Purpose: Verify Service Receipt Before Cursor. Keep this deterministic and fail closed.\nconst e = $('Build Frozen Mailbox Envelope').first().json;\nconst r = $json;\nif (r.cursor_committed !== false)\n    throw new Error('Companion must not commit the mailbox cursor');\nif (String(r.cursor_candidate || '') !== e.cursor)\n    throw new Error('Cursor candidate differs from frozen upper bound');\nconst scanned = Number(r.parse?.scanned_count);\nconst accepted = Number(r.parse?.accepted_count);\nif (scanned !== e.messages.length || !Number.isInteger(accepted) || accepted < 0 || accepted > scanned)\n    throw new Error('Companion parse counts do not reconcile');\nconst receipt = r.service_receipt;\nconst receipt_id = String(receipt?.receipt_id || '').trim();\nconst receipt_sha256 = String(receipt?.receipt_sha256 || '').trim();\nif (!receipt || typeof receipt !== 'object' || Array.isArray(receipt) || !receipt_id || !receipt_sha256)\n    throw new Error('Companion service receipt identity is required');\nreturn [{ json: { source: e.source, completed_at: e.completed_at, scanned_count: scanned, accepted_count: accepted, cursor: e.cursor, service_receipt: { receipt_id, receipt_sha256 } } }];\n"
