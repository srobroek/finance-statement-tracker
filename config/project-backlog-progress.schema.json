{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-backlog-progress-schema-v1",
  "type": "object",
  "required": [
    "schema_version", "recorded_at", "evidence_commit", "evidence_commits",
    "snapshot_notes", "resolved_blockers", "superseded_text_markers", "updates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "recorded_at": {"type": "string", "format": "date"},
    "evidence_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evidence_commits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "uniqueItems": true
    },
    "snapshot_notes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "resolved_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "superseded_text_markers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "updates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/update"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^(N8N|DOC|AGENT|ACTUAL|CASHBACK|BROWSER|AUTO|PLATFORM|DOCS)-[0-9]{3}$"
    },
    "status": {
      "enum": ["NOT_STARTED", "PARTIAL", "IMPLEMENTED_UNVERIFIED", "BLOCKED", "VERIFIED"]
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "update": {
      "type": "object",
      "required": [
        "id", "status", "implementation_state", "verification_state",
        "evidence_paths", "tests", "live_readback", "remaining_work",
        "blockers_remove", "blockers_add", "last_verified", "next_action"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/taskId"},
        "status": {"$ref": "#/$defs/status"},
        "implementation_state": {"type": "string", "minLength": 1},
        "verification_state": {"type": "string", "minLength": 1},
        "evidence_paths": {"$ref": "#/$defs/stringArray"},
        "tests": {"$ref": "#/$defs/stringArray"},
        "live_readback": {"type": "string"},
        "remaining_work": {"type": "string", "minLength": 1},
        "blockers_remove": {"$ref": "#/$defs/stringArray"},
        "blockers_add": {"$ref": "#/$defs/stringArray"},
        "last_verified": {"type": ["string", "null"], "format": "date"},
        "next_action": {"type": "string", "minLength": 1},
        "acceptance_criteria_met": {"type": "boolean"},
        "verification_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
