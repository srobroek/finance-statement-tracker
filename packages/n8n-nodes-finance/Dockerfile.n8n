ARG N8N_BASE_IMAGE=ghcr.io/n8n-io/n8n:2.37.10@sha256:307d6065be25619aa24cfc63a7c2f04ca56d084a08c05c8e9f189a89f353b1ec
FROM public.ecr.aws/docker/library/node:26.5.1-alpine@sha256:233761595746769ebfdb6090f44fc7cdf818ae0ce62d2b37e0367723b9823e36 AS node-builder

USER root
RUN apk add --no-cache \
      g++=15.2.0-r5 \
      make=4.4.1-r4 \
      python3=3.14.7-r1
WORKDIR /tmp/n8n-nodes-finance
COPY packages/n8n-nodes-finance/package.json packages/n8n-nodes-finance/package-lock.json packages/n8n-nodes-finance/tsconfig.json packages/n8n-nodes-finance/tsconfig.build.json ./
RUN npm ci --include=dev
COPY packages/n8n-nodes-finance/src ./src
COPY packages/n8n-nodes-finance/CONTRACT.md ./
RUN npm run build \
    && npm prune --omit=dev --omit=peer \
    && npm cache clean --force

WORKDIR /tmp/community-ai
COPY packages/n8n-nodes-finance/community-ai/package.json packages/n8n-nodes-finance/community-ai/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --legacy-peer-deps \
    && npm audit --omit=dev --audit-level=high \
    && test "$(node -p "require('./node_modules/n8n-nodes-prodex/package.json').version")" = "0.5.1" \
    && test "$(node -p "require('./node_modules/@openai/codex/package.json').version")" = "0.142.1"
COPY packages/n8n-nodes-finance/scripts/harden-community-ai.cjs /tmp/harden-community-ai.cjs
RUN node /tmp/harden-community-ai.cjs /tmp/community-ai/node_modules \
    && npm cache clean --force

FROM public.ecr.aws/docker/library/node:26.5.1-alpine@sha256:233761595746769ebfdb6090f44fc7cdf818ae0ce62d2b37e0367723b9823e36 AS nodemailer-builder

RUN npm pack nodemailer@9.1.0 --pack-destination /tmp >/tmp/nodemailer-pack.txt \
    && test "$(cat /tmp/nodemailer-pack.txt)" = "nodemailer-9.1.0.tgz" \
    && echo "fa0d4044a699101fff3706651423c4174ac41d59414a4cc039acebd348f102db  /tmp/nodemailer-9.1.0.tgz" | sha256sum -c - \
    && mkdir -p /tmp/nodemailer-9.1.0 \
    && tar -xzf /tmp/nodemailer-9.1.0.tgz -C /tmp/nodemailer-9.1.0 --strip-components=1 \
    && node -e "const p=require('/tmp/nodemailer-9.1.0/package.json'); if(p.name!=='nodemailer'||p.version!=='9.1.0') process.exit(1)"
COPY packages/n8n-nodes-finance/scripts/nodemailer-smoke.cjs /tmp/nodemailer-smoke.cjs
RUN node /tmp/nodemailer-smoke.cjs /tmp/nodemailer-9.1.0

FROM public.ecr.aws/docker/library/node:26.5.1-alpine@sha256:233761595746769ebfdb6090f44fc7cdf818ae0ce62d2b37e0367723b9823e36 AS javascript-security-overlay

RUN mkdir -p \
      /tmp/javascript-security-overlay/fast-uri \
      /tmp/javascript-security-overlay/toml \
      /tmp/javascript-security-overlay/tiptap-core \
      /tmp/javascript-security-overlay/tiptap-pm \
      /tmp/javascript-security-overlay/prosemirror-model \
      /tmp/javascript-security-overlay/prosemirror-view \
      /tmp/javascript-security-overlay/xmldom-xmldom \
      /tmp/javascript-security-overlay/js-yaml \
      /tmp/javascript-security-overlay/multer \
    && npm pack fast-uri@3.1.6 --pack-destination /tmp/javascript-security-overlay >/tmp/fast-uri-pack.txt \
    && test "$(cat /tmp/fast-uri-pack.txt)" = "fast-uri-3.1.6.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/fast-uri-3.1.6.tgz')).digest('base64'); if(actual!=='7Ical1vFEMr0onbVzEDIreM22I4khW+fzyQPwvAFWBp1iwdshSZRsL4jjRvPG9JP1uiqMHRto+YU6R2/CzDz5Q==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/fast-uri-3.1.6.tgz -C /tmp/javascript-security-overlay/fast-uri --strip-components=1 \
    && npm pack toml@4.2.0 --pack-destination /tmp/javascript-security-overlay >/tmp/toml-pack.txt \
    && test "$(cat /tmp/toml-pack.txt)" = "toml-4.2.0.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/toml-4.2.0.tgz')).digest('base64'); if(actual!=='TvAJjbHZlYmI323+srtqHQFyJsoWy6mI09ppkuj9+iRsqsVKG9fvTcOP7FHF2UCb0QSYtjEavffrKzdd0XgClg==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/toml-4.2.0.tgz -C /tmp/javascript-security-overlay/toml --strip-components=1 \
    && npm pack @tiptap/core@3.30.5 --pack-destination /tmp/javascript-security-overlay >/tmp/tiptap-core-pack.txt \
    && test "$(cat /tmp/tiptap-core-pack.txt)" = "tiptap-core-3.30.5.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/tiptap-core-3.30.5.tgz')).digest('base64'); if(actual!=='3O7N0FyKIfuLV+xrdWyDM3V5eUY/q2CgLjhhMwOAbM1Pu7VPp9VP+TpEYOdH8aRyB+h1vj5hX5A747D8ZrPfHA==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/tiptap-core-3.30.5.tgz -C /tmp/javascript-security-overlay/tiptap-core --strip-components=1 \
    && npm pack @tiptap/pm@3.30.5 --pack-destination /tmp/javascript-security-overlay >/tmp/tiptap-pm-pack.txt \
    && test "$(cat /tmp/tiptap-pm-pack.txt)" = "tiptap-pm-3.30.5.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/tiptap-pm-3.30.5.tgz')).digest('base64'); if(actual!=='gufkLkW2tA6PZPjivYxDiGzTIIftwqhmYI6lvvKu2S4FbhcysJgMAe/GXVSywzCRVVex9SrvCe6RFYrqnwRitQ==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/tiptap-pm-3.30.5.tgz -C /tmp/javascript-security-overlay/tiptap-pm --strip-components=1 \
    && npm pack prosemirror-model@1.25.11 --pack-destination /tmp/javascript-security-overlay >/tmp/prosemirror-model-pack.txt \
    && test "$(cat /tmp/prosemirror-model-pack.txt)" = "prosemirror-model-1.25.11.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/prosemirror-model-1.25.11.tgz')).digest('base64'); if(actual!=='QWg9RhnpLlogAmp3p96uEFrE5txQpFynd4vhBAELkwgOCWQs/X0yCzB3/hrHqiPwf91RG5KyWq6553zs9JqIOQ==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/prosemirror-model-1.25.11.tgz -C /tmp/javascript-security-overlay/prosemirror-model --strip-components=1 \
    && npm pack prosemirror-view@1.41.9 --pack-destination /tmp/javascript-security-overlay >/tmp/prosemirror-view-pack.txt \
    && test "$(cat /tmp/prosemirror-view-pack.txt)" = "prosemirror-view-1.41.9.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/prosemirror-view-1.41.9.tgz')).digest('base64'); if(actual!=='clTunTX+eaLbr87L1V1QPheRlEQJyTlL3gXe9x3jQIk3rL0RVWxviDGz8tFaydwIVm+hKhYCyr+R/zBtWr9s6A==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/prosemirror-view-1.41.9.tgz -C /tmp/javascript-security-overlay/prosemirror-view --strip-components=1 \
    && npm pack @xmldom/xmldom@0.8.15 --pack-destination /tmp/javascript-security-overlay >/tmp/xmldom-pack.txt \
    && test "$(cat /tmp/xmldom-pack.txt)" = "xmldom-xmldom-0.8.15.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/xmldom-xmldom-0.8.15.tgz')).digest('base64'); if(actual!=='/5NV/vDALVFDXgLmfsy9TRCBlKwO2LNBFzpzvb9iIj+jR+eSc6DLYYvVOdivT/jm7MtU6TebYuRmzEOI7w40UA==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/xmldom-xmldom-0.8.15.tgz -C /tmp/javascript-security-overlay/xmldom-xmldom --strip-components=1 \
    && npm pack js-yaml@4.3.2 --pack-destination /tmp/javascript-security-overlay >/tmp/js-yaml-pack.txt \
    && test "$(cat /tmp/js-yaml-pack.txt)" = "js-yaml-4.3.2.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/js-yaml-4.3.2.tgz')).digest('base64'); if(actual!=='SFNOvSJ+Dgf/9An904Yx+CgSlIPCkIpao4qo51lpee25TIRejdH3rhR4EZMGoNx3/TP3O+wzWuiTFl4sqbltzA==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/js-yaml-4.3.2.tgz -C /tmp/javascript-security-overlay/js-yaml --strip-components=1 \
    && npm pack multer@2.3.0 --pack-destination /tmp/javascript-security-overlay >/tmp/multer-pack.txt \
    && test "$(cat /tmp/multer-pack.txt)" = "multer-2.3.0.tgz" \
    && node -e "const fs=require('node:fs'),crypto=require('node:crypto'); const actual=crypto.createHash('sha512').update(fs.readFileSync('/tmp/javascript-security-overlay/multer-2.3.0.tgz')).digest('base64'); if(actual!=='cjNbm3sttszgZeGfJR124D+jFEfkXCVAsoPBmFn9X7UxmDSFHWqE2CoEj0vrmSpuAFnqWR1Szcm9QTsiHr60Xw==') process.exit(1)" \
    && tar -xzf /tmp/javascript-security-overlay/multer-2.3.0.tgz -C /tmp/javascript-security-overlay/multer --strip-components=1 \
    && rm -f /tmp/javascript-security-overlay/*.tgz /tmp/fast-uri-pack.txt /tmp/toml-pack.txt /tmp/tiptap-core-pack.txt /tmp/tiptap-pm-pack.txt /tmp/prosemirror-model-pack.txt /tmp/prosemirror-view-pack.txt /tmp/xmldom-pack.txt /tmp/js-yaml-pack.txt /tmp/multer-pack.txt
COPY packages/n8n-nodes-finance/scripts/javascript-security-overlay-smoke.cjs /tmp/javascript-security-overlay-smoke.cjs
RUN node /tmp/javascript-security-overlay-smoke.cjs \
      /tmp/javascript-security-overlay/fast-uri \
      /tmp/javascript-security-overlay/toml \
      /tmp/javascript-security-overlay/tiptap-core \
      /tmp/javascript-security-overlay/tiptap-pm \
      /tmp/javascript-security-overlay/prosemirror-model \
      /tmp/javascript-security-overlay/prosemirror-view \
      /tmp/javascript-security-overlay/xmldom-xmldom \
      /tmp/javascript-security-overlay/js-yaml \
      /tmp/javascript-security-overlay/multer \
    && npm cache clean --force

# The official n8n runtime deliberately omits apk-tools. Carry the static
# installer and trust keys from the immutable matching Alpine 3.24 builder;
# the runtime stage installs only exact-version, repository-signed fixes.
FROM public.ecr.aws/docker/library/node:26.5.1-alpine@sha256:233761595746769ebfdb6090f44fc7cdf818ae0ce62d2b37e0367723b9823e36 AS alpine-security-overlay

USER root
RUN apk add --no-cache apk-tools-static=3.0.8-r0 \
    && mkdir -p /tmp/security-apks \
    && cp /sbin/apk.static /tmp/security-apks/apk.static \
    && cp -R /etc/apk/keys /tmp/security-apks/keys

FROM ${N8N_BASE_IMAGE}

ARG N8N_BASE_IMAGE
ARG FINANCE_SOURCE_COMMIT=UNVERIFIED
LABEL org.opencontainers.image.source="https://github.com/srobroek/finance-statement-tracker" \
      org.opencontainers.image.revision="${FINANCE_SOURCE_COMMIT}" \
      io.finance.n8n.base-image="${N8N_BASE_IMAGE}" \
      io.finance.n8n.base-source="https://github.com/n8n-io/n8n@5542b8b6419cb6925cca8f11b270c9bfbe09d85e" \
      io.finance.n8n.os-security-overlay="alpine-v3.24:openssl-3.5.8-r0,expat-2.8.4-r0,openssh-10.3_p1-r1" \
      io.finance.n8n.nodemailer-recipe="https://github.com/srobroek/n8n-orchestrator@9bd6b55e88deade27591080e14f1a7c4bdc9808b"

USER root
COPY --from=alpine-security-overlay /tmp/security-apks /tmp/security-apks
RUN test ! -e /sbin/apk \
    && ln -s /tmp/security-apks/apk.static /sbin/apk \
    && /tmp/security-apks/apk.static --keys-dir /tmp/security-apks/keys add --no-cache \
      --repository https://dl-cdn.alpinelinux.org/alpine/v3.24/main \
      libcrypto3=3.5.8-r0 \
      libssl3=3.5.8-r0 \
      libexpat=2.8.4-r0 \
      openssh=10.3_p1-r1 \
      openssh-client-common=10.3_p1-r1 \
      openssh-client-default=10.3_p1-r1 \
      openssh-keygen=10.3_p1-r1 \
      openssh-server=10.3_p1-r1 \
      openssh-server-common=10.3_p1-r1 \
      openssh-sftp-server=10.3_p1-r1 \
    && /tmp/security-apks/apk.static info --exists libcrypto3=3.5.8-r0 \
    && /tmp/security-apks/apk.static info --exists libssl3=3.5.8-r0 \
    && /tmp/security-apks/apk.static info --exists libexpat=2.8.4-r0 \
    && /tmp/security-apks/apk.static info --exists openssh=10.3_p1-r1 \
    && /tmp/security-apks/apk.static info --exists openssh-client-common=10.3_p1-r1 \
    && /tmp/security-apks/apk.static info --exists openssh-client-default=10.3_p1-r1 \
    && /tmp/security-apks/apk.static info --exists openssh-keygen=10.3_p1-r1 \
    && /tmp/security-apks/apk.static info --exists openssh-server=10.3_p1-r1 \
    && /tmp/security-apks/apk.static info --exists openssh-server-common=10.3_p1-r1 \
    && /tmp/security-apks/apk.static info --exists openssh-sftp-server=10.3_p1-r1 \
    && ! /tmp/security-apks/apk.static info --exists libcrypto3=3.5.7-r1 \
    && rm -f /sbin/apk \
    && rm -rf /tmp/security-apks \
    && test ! -e /sbin/apk
RUN test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/fast-uri@3.1.5/node_modules/fast-uri \
    && test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/toml@3.0.0/node_modules/toml \
    && test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+core@3.27.0_@tiptap+pm@3.27.0/node_modules/@tiptap/core \
    && test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+pm@3.27.0/node_modules/@tiptap/pm \
    && test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-model@1.25.10/node_modules/prosemirror-model \
    && test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-view@1.41.8/node_modules/prosemirror-view \
    && test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@xmldom+xmldom@0.8.14/node_modules/@xmldom/xmldom \
    && test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/js-yaml@4.3.1/node_modules/js-yaml \
    && test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/multer@2.2.0/node_modules/multer \
    && rm -rf \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/fast-uri@3.1.5/node_modules/fast-uri \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/toml@3.0.0/node_modules/toml \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+core@3.27.0_@tiptap+pm@3.27.0/node_modules/@tiptap/core \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+pm@3.27.0/node_modules/@tiptap/pm \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-model@1.25.10/node_modules/prosemirror-model \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-view@1.41.8/node_modules/prosemirror-view \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@xmldom+xmldom@0.8.14/node_modules/@xmldom/xmldom \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/js-yaml@4.3.1/node_modules/js-yaml \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/multer@2.2.0/node_modules/multer \
    && mkdir -p \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/fast-uri@3.1.5/node_modules/fast-uri \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/toml@3.0.0/node_modules/toml \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+core@3.27.0_@tiptap+pm@3.27.0/node_modules/@tiptap/core \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+pm@3.27.0/node_modules/@tiptap/pm \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-model@1.25.10/node_modules/prosemirror-model \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-view@1.41.8/node_modules/prosemirror-view \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@xmldom+xmldom@0.8.14/node_modules/@xmldom/xmldom \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/js-yaml@4.3.1/node_modules/js-yaml \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/multer@2.2.0/node_modules/multer
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/fast-uri/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/fast-uri@3.1.5/node_modules/fast-uri/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/toml/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/toml@3.0.0/node_modules/toml/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/tiptap-core/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+core@3.27.0_@tiptap+pm@3.27.0/node_modules/@tiptap/core/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/tiptap-pm/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+pm@3.27.0/node_modules/@tiptap/pm/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/prosemirror-model/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-model@1.25.10/node_modules/prosemirror-model/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/prosemirror-view/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-view@1.41.8/node_modules/prosemirror-view/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/xmldom-xmldom/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@xmldom+xmldom@0.8.14/node_modules/@xmldom/xmldom/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/js-yaml/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/js-yaml@4.3.1/node_modules/js-yaml/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay/multer/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/multer@2.2.0/node_modules/multer/
COPY --from=javascript-security-overlay /tmp/javascript-security-overlay-smoke.cjs /tmp/javascript-security-overlay-smoke.cjs
RUN node /tmp/javascript-security-overlay-smoke.cjs \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/fast-uri@3.1.5/node_modules/fast-uri \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/toml@3.0.0/node_modules/toml \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/ajv@8.20.0/node_modules/ajv \
      /usr/local/lib/node_modules/n8n/node_modules \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+core@3.27.0_@tiptap+pm@3.27.0/node_modules/@tiptap/core \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@tiptap+pm@3.27.0/node_modules/@tiptap/pm \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-model@1.25.10/node_modules/prosemirror-model \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/prosemirror-view@1.41.8/node_modules/prosemirror-view \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@xmldom+xmldom@0.8.14/node_modules/@xmldom/xmldom \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/js-yaml@4.3.1/node_modules/js-yaml \
      /usr/local/lib/node_modules/n8n/node_modules/.pnpm/multer@2.2.0/node_modules/multer \
    && rm -f /tmp/javascript-security-overlay-smoke.cjs
RUN test -d /usr/local/lib/node_modules/n8n/node_modules/.pnpm/nodemailer@8.0.10/node_modules/nodemailer \
    && rm -rf /usr/local/lib/node_modules/n8n/node_modules/.pnpm/nodemailer@8.0.10/node_modules/nodemailer \
    && mkdir -p /usr/local/lib/node_modules/n8n/node_modules/.pnpm/nodemailer@8.0.10/node_modules/nodemailer
COPY --from=nodemailer-builder /tmp/nodemailer-9.1.0/ /usr/local/lib/node_modules/n8n/node_modules/.pnpm/nodemailer@8.0.10/node_modules/nodemailer/
COPY --from=nodemailer-builder /tmp/nodemailer-smoke.cjs /tmp/nodemailer-smoke.cjs
RUN node -e "const p=require('/usr/local/lib/node_modules/n8n/node_modules/nodemailer/package.json'); if(p.name!=='nodemailer'||p.version!=='9.1.0'||typeof require('/usr/local/lib/node_modules/n8n/node_modules/nodemailer').createTransport!=='function') process.exit(1)" \
    && test "$(n8n --version)" = "2.37.10" \
    && node /tmp/nodemailer-smoke.cjs /usr/local/lib/node_modules/n8n/node_modules/nodemailer \
    && rm -f /tmp/nodemailer-smoke.cjs
RUN mkdir -p /opt/finance-n8n/custom-extensions/n8n-nodes-finance
COPY --from=node-builder --chown=node:node /tmp/n8n-nodes-finance/package.json /opt/finance-n8n/custom-extensions/n8n-nodes-finance/package.json
COPY --from=node-builder --chown=node:node /tmp/n8n-nodes-finance/CONTRACT.md /opt/finance-n8n/custom-extensions/n8n-nodes-finance/CONTRACT.md
COPY --from=node-builder --chown=node:node /tmp/n8n-nodes-finance/dist /opt/finance-n8n/custom-extensions/n8n-nodes-finance/dist
COPY --from=node-builder --chown=node:node /tmp/n8n-nodes-finance/node_modules /opt/finance-n8n/custom-extensions/n8n-nodes-finance/node_modules
COPY --from=node-builder --chown=node:node /tmp/community-ai/package.json /opt/finance-n8n/community-extensions/package.json
COPY --from=node-builder --chown=node:node /tmp/community-ai/package-lock.json /opt/finance-n8n/community-extensions/package-lock.json
COPY --from=node-builder --chown=node:node /tmp/community-ai/node_modules /opt/finance-n8n/community-extensions/node_modules
COPY --chown=node:node packages/n8n-nodes-finance/scripts/assert-runtime-registration.cjs /opt/finance-n8n/assert-runtime-registration.cjs
COPY --chown=node:node packages/n8n-nodes-finance/scripts/verify-immutable-extension.cjs /opt/finance-n8n/verify-immutable-extension.cjs
COPY --chown=node:node packages/n8n-nodes-finance/scripts/finance-entrypoint.sh /opt/finance-n8n/finance-entrypoint.sh
RUN node /opt/finance-n8n/verify-immutable-extension.cjs --write \
    && if [ -e /home/node/node_modules ] || [ -L /home/node/node_modules ]; then echo 'FINANCE_NODE_MODULES_PATH_MUST_BE_ABSENT' >&2; exit 1; fi \
    && ln -s /opt/finance-n8n/community-extensions/node_modules /home/node/node_modules \
    && chmod 0555 /opt/finance-n8n/finance-entrypoint.sh \
    && chmod 0444 /opt/finance-n8n/extension-tree.sha256
WORKDIR /home/node
USER node
ENTRYPOINT ["tini", "--", "/opt/finance-n8n/finance-entrypoint.sh"]
