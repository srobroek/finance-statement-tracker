    {
      "workflow_code": "W09",
      "workflow_path": "integrations/n8n/workflows/09-ai-proposal.json",
      "selection_key": "policy_id",
      "sources": [
        {
          "path": "config/ai-policies.json",
          "sha256": "b224df4335e48707d41f11623d370859b9b49ce3334640910280cc8117529dff"
        }
      ],
      "entries": [
        {
          "key": "classify-unresolved",
          "value": {
            "policy_id": "classify-unresolved",
            "version": 2,
            "agent_profile": "LUNA_MAX",
            "name": "Classify unresolved purchases",
            "priority": 10,
            "instruction": "Using the merchant description and existing deterministic outputs, propose only a vendor, category, subcategory, or approved reporting tags. Do not infer source facts. Leave a field unresolved when evidence is weak.",
            "target_fields": [
              "vendor",
              "category",
              "subcategory",
              "tags"
            ],
            "trigger_fields": [
              "category"
            ],
            "conditions": [
              {
                "field": "transaction_type",
                "operator": "equals",
                "value": "PURCHASE"
              }
            ],
            "minimum_confidence": 0.82,
            "allowed_value_sources": {
              "category": "actual.categories"
            },
            "allowed_tags": [
              "home",
              "grocery",
              "dining",
              "transport",
              "travel",
              "online",
              "health",
              "education",
              "gift",
              "business",
              "shared",
              "review"
            ]
          }
        },
        {
          "key": "recommend-category",
          "value": {
            "policy_id": "recommend-category",
            "version": 1,
            "agent_profile": "SOL_MEDIUM",
            "name": "Recommend a missing category",
            "priority": 15,
            "instruction": "Only when no configured category fits after static rules and history matching, propose a category_recommendation object with a concise name, the best existing or proposed group, and an evidence-based reason. Do not create or assign the category. The proposal must remain review-required until an owner adds the category and reruns classification.",
            "target_fields": [
              "category_recommendation"
            ],
            "trigger_fields": [
              "category_recommendation"
            ],
            "conditions": [
              {
                "field": "transaction_type",
                "operator": "equals",
                "value": "PURCHASE",
                "group": 1
              },
              {
                "field": "category",
                "operator": "is_empty",
                "group": 1
              }
            ],
            "minimum_confidence": 0.92
          }
        },
        {
          "key": "detect-subscription",
          "value": {
            "policy_id": "detect-subscription",
            "version": 1,
            "agent_profile": "LUNA_MAX",
            "name": "Detect recurring subscription",
            "priority": 20,
            "instruction": "Mark a transaction as a subscription only when the merchant or related evidence indicates a recurring service. Add only approved subscription tags.",
            "target_fields": [
              "is_subscription",
              "tags"
            ],
            "trigger_fields": [
              "is_subscription"
            ],
            "conditions": [
              {
                "field": "transaction_type",
                "operator": "equals",
                "value": "PURCHASE",
                "group": 1
              },
              {
                "field": "category",
                "operator": "in",
                "value": [
                  "Software & App Subscriptions",
                  "Media Subscriptions",
                  "Mobile & Internet",
                  "Cloud Services"
                ],
                "group": 1
              }
            ],
            "minimum_confidence": 0.9,
            "allowed_values": {
              "is_subscription": [
                true
              ]
            },
            "allowed_tags": [
              "subscription",
              "recurring"
            ]
          }
        },
        {
          "key": "enrich-property",
          "value": {
            "policy_id": "enrich-property",
            "version": 2,
            "agent_profile": "SOL_MEDIUM",
            "name": "Enrich property and rental unit",
            "priority": 30,
            "instruction": "Use explicit transaction or linked email evidence to identify only a configured property and rental unit. Never guess a unit from amount alone. The deterministic property registry adds reporting tags after the identity is accepted.",
            "target_fields": [
              "property_code",
              "rental_unit"
            ],
            "conditions": [
              {
                "field": "category",
                "operator": "in",
                "value": [
                  "Electricity & Water",
                  "District Cooling",
                  "Service Charges",
                  "Maintenance & Repairs",
                  "Rental Income"
                ]
              }
            ],
            "minimum_confidence": 0.9,
            "allowed_value_sources": {
              "property_code": "properties.codes",
              "rental_unit": "properties.rental_units"
            }
          }
        },
        {
          "key": "find-purchase-evidence",
          "value": {
            "policy_id": "find-purchase-evidence",
            "version": 2,
            "agent_profile": "LUNA_MAX",
            "name": "Find receipt bill or warranty evidence",
            "priority": 40,
            "instruction": "Use config/evidence-search-policy.json and its store/do-not-store examples. Propose an evidence search for document-worthy categories or for a qualifying high-value transaction whose statement description lacks the product detail. The evidence worker searches vendor aliases plus amount/currency within the date buffer and uses matched email/order content to identify the product, model, order reference, serial number, warranty dates, or return deadline. Never propose a vendor-only match or evidence collection for a configured never-search category unless a manual evidence request exists.",
            "target_fields": [
              "evidence_policy"
            ],
            "trigger_fields": [
              "evidence_policy"
            ],
            "conditions": [
              {
                "field": "transaction_type",
                "operator": "equals",
                "value": "PURCHASE",
                "group": 1
              },
              {
                "field": "category",
                "operator": "in",
                "value": [
                  "Electricity & Water",
                  "District Cooling",
                  "Service Charges",
                  "Maintenance & Repairs",
                  "Electronics",
                  "Furniture & Appliances",
                  "Flights",
                  "Accommodation",
                  "Insurance"
                ],
                "group": 1
              },
              {
                "field": "transaction_type",
                "operator": "equals",
                "value": "PURCHASE",
                "group": 2
              },
              {
                "field": "amount_aed",
                "operator": "gte",
                "value": "500",
                "group": 2
              },
              {
                "field": "category",
                "operator": "in",
                "value": [
                  "Groceries",
                  "Dining Out",
                  "Food Delivery",
                  "Coffee & Snacks",
                  "Fuel",
                  "Parking & Tolls",
                  "Ride Hailing",
                  "Public Transport",
                  "Rent & Mortgage",
                  "Mortgage Interest",
                  "Mortgage Payments",
                  "Investment Contributions",
                  "Investments",
                  "Savings Transfers",
                  "Internal Transfers",
                  "Cash Withdrawal",
                  "Card Payments",
                  "Bank Fees"
                ],
                "group": 2,
                "negate": true
              }
            ],
            "minimum_confidence": 0.8,
            "allowed_values": {
              "evidence_policy": [
                "SEARCH_RELATED_EMAIL",
                "SEARCH_RECEIPT_BILL_WARRANTY",
                "MATCH_AMOUNT_AND_PERIOD"
              ]
            }
          }
        },
        {
          "key": "enrich-cashback-classification",
          "value": {
            "policy_id": "enrich-cashback-classification",
            "version": 1,
            "agent_profile": "LUNA_MAX",
            "name": "Enrich channel and cashback bucket",
            "priority": 50,
            "instruction": "Only when deterministic rules leave them unresolved, infer channel or propose a configured cashback bucket from explicit merchant, notification, wallet, currency, and card evidence. Do not calculate rewards or invent wallet usage.",
            "target_fields": [
              "channel",
              "reward_bucket"
            ],
            "trigger_fields": [
              "channel",
              "reward_bucket"
            ],
            "conditions": [
              {
                "field": "transaction_type",
                "operator": "equals",
                "value": "PURCHASE",
                "group": 1
              },
              {
                "field": "card",
                "operator": "in",
                "value": [
                  "RAK_WORLD",
                  "SC_PLATINUM_X"
                ],
                "group": 1
              }
            ],
            "minimum_confidence": 0.95,
            "allowed_values": {
              "channel": [
                "ONLINE",
                "PHYSICAL_POS",
                "APPLE_PAY_POS",
                "UNKNOWN"
              ]
            },
            "allowed_value_sources": {
              "reward_bucket": "cashback.buckets"
            }
          }
        },
        {
          "key": "recommend-static-rule",
          "value": {
            "policy_id": "recommend-static-rule",
            "version": 1,
            "agent_profile": "SOL_MEDIUM",
            "name": "Recommend a repeated-pattern rule",
            "priority": 90,
            "instruction": "Only when transaction metadata contains at least three consistent reviewed examples for the same normalized merchant pattern, propose a disabled canonical static-rule draft. Include the evidence count and never execute the recommendation.",
            "target_fields": [
              "rule_recommendation"
            ],
            "conditions": [
              {
                "field": "history_count",
                "operator": "gte",
                "value": 3
              }
            ],
            "minimum_confidence": 0.95
          }
        }
      ]
    }
  ],
