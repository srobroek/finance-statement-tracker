{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxsan.com/schemas/finance-n8n-source-contract-bindings-v1.json",
  "title": "Finance n8n nonsecret source-contract deployment bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "manifest_sha256",
    "source",
    "workflows",
    "bindings",
    "activation_prerequisites"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_status": {
      "enum": [
        "ACTIVATION_REQUIRED",
        "READY"
      ]
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "table",
        "allowed_fields"
      ],
      "properties": {
        "path": {
          "const": "integrations/n8n/generated/application-contract-bundle.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "table": {
          "const": "finance_source_contracts"
        },
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_code",
              "config_version",
              "folder_id",
              "senders_json",
              "subjects_json",
              "onedrive_parent_id",
              "manifest_onedrive_parent_id",
              "overlap_seconds",
              "cycle_day",
              "deadline_days",
              "actual_file_id",
              "account_id",
              "card_code",
              "cashback_close_required",
              "enabled",
              "content_sha256",
              "updated_at"
            ]
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "workflow_id",
          "workflow_code",
          "source_sha256",
          "slot_metadata_key"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^integrations/n8n/workflows/[A-Za-z0-9_-]+\\.json$"
          },
          "workflow_id": {
            "type": "string",
            "minLength": 1
          },
          "workflow_code": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "slot_metadata_key": {
            "const": "financeSourceBindingSlots"
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      },
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]+$"
      }
    },
    "activation_prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_code",
          "fields",
          "reason"
        ],
        "properties": {
          "source_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_code",
        "config_version",
        "folder_id",
        "senders_json",
        "subjects_json",
        "onedrive_parent_id",
        "manifest_onedrive_parent_id",
        "overlap_seconds",
        "cycle_day",
        "deadline_days",
        "actual_file_id",
        "account_id",
        "card_code",
        "cashback_close_required",
        "enabled",
        "content_sha256",
        "updated_at"
      ],
      "properties": {
        "source_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "config_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "folder_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "senders_json": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2
        },
        "subjects_json": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2
        },
        "onedrive_parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_onedrive_parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "overlap_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cycle_day": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 31
        },
        "deadline_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actual_file_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "card_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cashback_close_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
