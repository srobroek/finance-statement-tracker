      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Verify Hash Profile and State. Keep this deterministic and fail closed.\nconst req = $('Validate Narrow Tool Input').first().json, row = $json;\nif (row.source_sha256 !== req.expected_sha256 || row.document_profile !== req.document_profile || row.requested_schema_version !== req.requested_schema_version)\n    throw new Error('Document identity mismatch');\nif (['COMMITTED', 'QUARANTINED', 'UNSUPPORTED', 'PASSWORD_FAILED'].includes(row.state))\n    throw new Error(`Document is terminal: ${row.state}`);\nreturn [{ json: row }];\n"
      }
    },
