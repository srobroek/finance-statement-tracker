      ],
      "parameters": {
        "jsCode": "// Purpose: Redact and Classify Failure. Keep this deterministic and fail closed.\nconst e = $json.execution || {}, w = $json.workflow || {}, last = String(e.lastNodeExecuted || '');\nif (!String(e.id || '').trim() || !String(w.id || '').trim() || String(e.id).length > 128 || String(w.id).length > 128)\n    throw new Error('FAILURE_EXECUTION_IDENTITY_REQUIRED');\nconst raw = String(e.error?.message || $json.error?.message || 'Unknown workflow failure'), status = Number(e.error?.httpCode || e.error?.statusCode || 0), retryable = status === 429 || status >= 500 || /timeout|ECONNRESET|ENOTFOUND|temporar/i.test(raw);\nconst provider_code = /Outlook|OneDrive|Microsoft/i.test(last) ? 'MICROSOFT_GRAPH' : /Codex|Subscription Agent/i.test(last) ? 'CODEX_SUBSCRIPTION' : /Actual/i.test(last) ? 'ACTUAL_BUDGET' : /Cashback/i.test(last) ? 'CASHBACK_COMPANION' : /Finance Executions|n8n/i.test(last) ? 'N8N_API' : '';\nreturn [{ json: { execution_id: String(e.id || ''), workflow_id: String(w.id || ''), workflow_name: String(w.name || '').slice(0, 200), workflow_code: String(w.financeWorkflowCode || ''), run_id: String(e.id || ''), provider_code, error_class: retryable ? 'TRANSIENT' : 'TERMINAL', error_message_redacted: `${retryable ? 'Transient' : 'Terminal'} ${provider_code || 'workflow'} failure; HTTP ${Number.isInteger(status) ? status : 0}; node ${last.replace(/[^A-Za-z0-9 _-]/g, '').slice(0, 80)}`, first_seen_at: new Date().toISOString(), readback_verified: false } }];\n"
      }
