{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vxsan.com/schemas/finance-ai-proposal-v1.json",
  "title":"Finance AI proposal-only result",
  "type":"object","additionalProperties":false,
  "required":["schema_version","job_id","idempotency_key","policy_id","policy_class","policy_sha256","config_sha256","output_schema_sha256","runner_receipt_id","runner_model","runner_reasoning_effort","auth_mode","proposals"],
  "properties":{
    "schema_version":{"const":1},
    "job_id":{"type":"string","pattern":"^finance-ai:[a-f0-9]{64}$"},
    "idempotency_key":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "policy_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9:_-]{0,127}$"},
    "policy_class":{"enum":["NORMAL","EXCEPTION"]},
    "policy_sha256":{"$ref":"#/$defs/sha256"},
    "config_sha256":{"$ref":"#/$defs/sha256"},
    "output_schema_sha256":{"$ref":"#/$defs/sha256"},
    "runner_receipt_id":{"type":"string","minLength":1,"maxLength":256},
    "runner_model":{"enum":["gpt-5.6-luna","gpt-5.6-sol"]},
    "runner_reasoning_effort":{"enum":["max","xhigh"]},
    "auth_mode":{"const":"CHATGPT_SUBSCRIPTION"},
    "proposals":{"type":"array","maxItems":600,"items":{"$ref":"#/$defs/proposal"}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "proposal":{
      "type":"object","additionalProperties":false,
      "required":["transaction_id","field","value","confidence"],
      "properties":{
        "transaction_id":{"type":"string","minLength":1,"maxLength":256},
        "field":{"enum":["vendor","category","subcategory","tags","evidence_policy","review_required","category_recommendation","is_subscription","property_code","rental_unit","channel","reward_bucket","rule_recommendation"]},
        "value":{"type":["string","boolean","array","object"]},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "reason_code":{"type":"string","pattern":"^[A-Z0-9_:-]{1,128}$"}
      },
      "allOf":[
        {"if":{"properties":{"field":{"const":"tags"}},"required":["field"]},"then":{"properties":{"value":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z0-9:_-]+$"}}}}},
        {"if":{"properties":{"field":{"const":"review_required"}},"required":["field"]},"then":{"properties":{"value":{"type":"boolean"}}}},
        {"if":{"properties":{"field":{"const":"is_subscription"}},"required":["field"]},"then":{"properties":{"value":{"type":"boolean"}}}},
        {"if":{"properties":{"field":{"enum":["vendor","category","subcategory","evidence_policy","property_code","rental_unit","channel","reward_bucket"]}},"required":["field"]},"then":{"properties":{"value":{"type":"string","minLength":1,"maxLength":128}}}},
        {"if":{"properties":{"field":{"const":"category_recommendation"}},"required":["field"]},"then":{"properties":{"value":{"type":"object","additionalProperties":false,"required":["name","group","reason"],"properties":{"name":{"type":"string","minLength":1,"maxLength":80},"group":{"type":"string","minLength":1,"maxLength":80},"reason":{"type":"string","minLength":1,"maxLength":300}}}}}},
        {"if":{"properties":{"field":{"const":"rule_recommendation"}},"required":["field"]},"then":{"properties":{"value":{"type":"object","additionalProperties":false,"required":["rule_id","name","stage","priority","match","action","evidence_count","enabled"],"properties":{"rule_id":{"type":"string","pattern":"^[a-z0-9-]{3,80}$"},"name":{"type":"string","minLength":1,"maxLength":100},"stage":{"enum":["VENDOR_NORMALIZATION","CLASSIFICATION","TAGGING"]},"priority":{"type":"integer","minimum":1,"maximum":10000},"match":{"type":"object","additionalProperties":false,"required":["field","operator","value"],"properties":{"field":{"enum":["merchant_raw","vendor"]},"operator":{"enum":["equals","contains","regex"]},"value":{"type":"string","minLength":1,"maxLength":200}}},"action":{"type":"object","additionalProperties":false,"required":["action","field","value"],"properties":{"action":{"enum":["set","set_if_empty","add_tag"]},"field":{"enum":["vendor","category","subcategory","tags"]},"value":{"type":"string","minLength":1,"maxLength":128}}},"evidence_count":{"type":"integer","minimum":3,"maximum":10000},"enabled":{"const":false}}}}}}
      ]
    }
  }
}
