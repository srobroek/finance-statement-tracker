    {
      "id": "21007",
      "name": "Normalize Community Provider Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "jsCode": "// Purpose: Normalize Community Provider Output. Keep this deterministic and fail closed.\nconst provider = $('Validate and Build Fixed Provider Invocation').item.json.agent_provider;\nlet proposal;\nif (provider === 'CODEX_SUBSCRIPTION') {\n    proposal = typeof $json.output === 'string' ? JSON.parse($json.output) : $json.output;\n}\nelse {\n    if ($json.success !== true || $json.json?.ok !== true) {\n        throw new Error('CLAUDE_PROVIDER_JSON_OUTPUT_INVALID');\n    }\n    proposal = $json.json.value;\n}\nif (!proposal || typeof proposal !== 'object' || Array.isArray(proposal)) {\n    throw new Error('AGENT_PROVIDER_PROPOSAL_OBJECT_REQUIRED');\n}\nreturn [{ json: proposal }];\n"
      }
    },
