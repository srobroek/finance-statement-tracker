{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-acceptance-schema-v1",
  "type": "object",
  "required": ["schema_version", "generated_at", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "status", "production_gate", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "description": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["VERIFIED", "IMPLEMENTED_NOT_DEPLOYED", "PARTIAL", "BLOCKED", "MISSING", "SUPERSEDED"]
          },
          "production_gate": {"type": "boolean"},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "blockers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
