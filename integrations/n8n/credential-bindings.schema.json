{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxsan.com/schemas/finance-n8n-credential-bindings-v1.json",
  "title": "Finance n8n credential binding identities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_code_metadata_key", "source", "bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "workflow_code_metadata_key": {"const": "financeWorkflowCode"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_count", "sha256"],
      "properties": {
        "path": {"const": "integrations/n8n/workflows"},
        "file_count": {"const": 19},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "placeholder": {"type": "string", "pattern": "^BIND_[A-Z0-9_]+$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholder", "credential_type", "node_type", "nodes"],
      "properties": {
        "placeholder": {"$ref": "#/$defs/placeholder"},
        "credential_type": {"type": "string", "minLength": 1},
        "node_type": {"type": "string", "minLength": 1},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow", "node"],
            "properties": {
              "workflow": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "file", "id"],
                "properties": {
                  "code": {"type": "string", "minLength": 1},
                  "file": {"type": "string", "pattern": "^[^/]+\\.json$"},
                  "id": {"type": "string", "minLength": 1}
                }
              },
              "node": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "name": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
