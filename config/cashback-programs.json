{
  "schema_version": 2,
  "status": "USER_CONFIRMED",
  "currency": "AED",
  "profile": {
    "name": "Cashback Control",
    "locale": "en-AE"
  },
  "notes": "Card cycles, reward thresholds, bucket caps, routing behavior and eligibility were confirmed by the cardholder on 2026-08-17. These programme claims remain non-authoritative until each rate, cap, exclusion and tier is mapped to dated issuer evidence with a content digest.",
  "defaults": {
    "pace": {
      "basis": "WEEKLY",
      "routing_basis": "CYCLE",
      "week_length_days": 7,
      "tolerance_percent": "0.05",
      "minimum_tolerance": "250"
    },
    "alerts": {
      "bucket_near_full_ratio": "0.90",
      "minimum_risk_after_week": 3,
      "close_warning_days": 7,
      "close_critical_days": 3
    }
  },
  "normalization": {
    "default_purchase_type": "GENERAL",
    "default_channel": "UNKNOWN",
    "card_default_channels": {
      "RAK_WORLD": "APPLE_PAY_POS"
    },
    "actual_category_purchase_types": {
      "Groceries": "GROCERY",
      "Dining Out": "DINING",
      "Food Delivery": "DINING",
      "Flights": "AIRLINE",
      "Accommodation": "HOTEL",
      "Travel Transport": "TRAVEL",
      "Travel Activities": "TRAVEL",
      "Online Shopping": "GENERAL"
    },
    "merchant_purchase_types": [
      {"contains": "AMAZON", "purchase_type": "AMAZON"}
    ],
    "merchant_channels": [
      {"contains": "AMAZON", "channel": "ONLINE"},
      {"contains": "APPLE.COM/BILL", "channel": "ONLINE"},
      {"contains": "DEWA", "channel": "ONLINE"},
      {"contains": "EMPOWER", "channel": "ONLINE"}
    ]
  },
  "route_policies": {
    "CATEGORY_BUCKET": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "target_rate_positive": true},
      "ranking": {"groups_by_pace": {"*": 0}},
      "reasons": {"*": "Category bucket has enough headroom for the whole purchase and its target-tier rate is active."}
    },
    "REWARD_BUCKET": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "net_value_positive": true},
      "ranking": {"groups_by_pace": {"UNDER": 1, "ON_PACE": 2, "OVER": 3, "SECURED": 3, "*": 2}},
      "reasons": {
        "UNDER": "Prioritize this card: its target is unmet, cycle pace is under, and this reward bucket has headroom.",
        "OVER": "Keep as a fallback: this reward bucket has headroom, but the card is already over cycle pace.",
        "*": "Reward bucket has headroom and positive economic value."
      }
    },
    "SPECIALIST": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "net_value_positive": true},
      "ranking": {"groups_by_pace": {"UNDER": 1, "ON_PACE": 2, "OVER": 3, "SECURED": 3, "OPEN": 3, "*": 3}},
      "reasons": {"*": "Eligible positive-value specialist remains available."}
    },
    "AMAZON_THRESHOLD_FILLER": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "target_unmet": true},
      "ranking": {"groups_by_pace": {"*": 1}},
      "reasons": {"*": "Route eligible Amazon spend to this card while its minimum-spend target is unmet and the configured reward bucket has room for the whole purchase."}
    },
    "THRESHOLD_FILLER": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "target_unmet": true},
      "ranking": {"groups_by_pace": {"UNDER": 2, "ON_PACE": 4, "OVER": 5, "SECURED": 5, "*": 5}},
      "reasons": {
        "UNDER": "Use as threshold filler because the card target is unmet and cycle pace is under.",
        "*": "Keep as fallback filler: the card target is unmet, but higher-priority allocation needs are satisfied first."
      }
    },
    "FALLBACK": {
      "when": {"bucket_open": true, "bucket_fits_purchase": true, "net_value_positive": true},
      "ranking": {"groups_by_pace": {"*": 6}},
      "reasons": {"*": "Eligible positive-value fallback remains available."}
    }
  },
  "live_ingestion": {
    "canonical_rule_source": "static-rules.seed.json",
    "rule_set": "LIVE_CASHBACK"
  },
