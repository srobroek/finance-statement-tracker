,\"channel\",\"reward_bucket\",\"rule_recommendation\"]},\"value\":{},\"confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"reason_code\":{\"type\":\"string\",\"pattern\":\"^[A-Z0-9_:-]{0,128}$\"}},\"oneOf\":[{\"properties\":{\"field\":{\"enum\":[\"vendor\",\"category\",\"subcategory\",\"evidence_policy\",\"property_code\",\"rental_unit\",\"channel\",\"reward_bucket\"]},\"value\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":128}}},{\"properties\":{\"field\":{\"const\":\"tags\"},\"value\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":12,\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":64,\"pattern\":\"^[a-z0-9:_-]+$\"}}}},{\"properties\":{\"field\":{\"enum\":[\"review_required\",\"is_subscription\"]},\"value\":{\"type\":\"boolean\"}}},{\"properties\":{\"field\":{\"const\":\"category_recommendation\"},\"value\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"name\",\"group\",\"reason\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":80},\"group\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":80},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":300}}}}},{\"properties\":{\"field\":{\"const\":\"rule_recommendation\"},\"value\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"enabled\",\"evidence_count\"],\"properties\":{\"enabled\":{\"const\":false},\"evidence_count\":{\"type\":\"integer\",\"minimum\":3,\"maximum\":10000}}}}}]}}},\"allOf\":[{\"oneOf\":[{\"properties\":{\"agent_provider\":{\"const\":\"CODEX_SUBSCRIPTION\"},\"policy_class\":{\"const\":\"NORMAL\"},\"runner_model\":{\"const\":\"gpt-5.6-luna\"},\"runner_reasoning_effort\":{\"const\":\"max\"},\"auth_mode\":{\"const\":\"CHATGPT_SUBSCRIPTION\"}}},{\"properties\":{\"agent_provider\":{\"const\":\"CODEX_SUBSCRIPTION\"},\"policy_class\":{\"const\":\"EXCEPTION\"},\"runner_model\":{\"const\":\"gpt-5.6-sol\"},\"runner_reasoning_effort\":{\"const\":\"medium\"},\"auth_mode\":{\"const