{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vxsan.com/schemas/codex-agent-handoff-v1.json",
  "title":"Bounded subscription-agent finance proposal job",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","job_id","idempotency_key","operation_code","agent_provider","policy_id","policy_class","policy_sha256","config_sha256","output_schema_sha256","unresolved"],
  "properties":{
    "schema_version":{"const":1},
    "job_id":{"type":"string","pattern":"^finance-ai:[a-f0-9]{64}$"},
    "idempotency_key":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "operation_code":{"const":"FINANCE_AI_PROPOSAL"},
    "agent_provider":{"enum":["CODEX_SUBSCRIPTION","CLAUDE_SUBSCRIPTION"]},
    "policy_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9:_-]{0,127}$"},
    "policy_class":{"enum":["NORMAL","EXCEPTION"]},
    "policy_sha256":{"$ref":"#/$defs/sha256"},
    "config_sha256":{"$ref":"#/$defs/sha256"},
    "output_schema_sha256":{"$ref":"#/$defs/sha256"},
    "unresolved":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/unresolved"}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "unresolved":{
      "type":"object","additionalProperties":false,
      "required":["transaction_id","allowed_fields","allowed_values","redacted_context"],
      "properties":{
        "transaction_id":{"type":"string","minLength":1,"maxLength":256},
        "allowed_fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["vendor","category","subcategory","tags","evidence_policy","review_required","category_recommendation","is_subscription","property_code","rental_unit","channel","reward_bucket","rule_recommendation"]}},
        "allowed_values":{
          "type":"object","maxProperties":10,"additionalProperties":false,
          "properties":{
            "category":{"$ref":"#/$defs/stringDomain"},
            "subcategory":{"$ref":"#/$defs/stringDomain"},
            "tags":{"$ref":"#/$defs/stringDomain"},
            "evidence_policy":{"$ref":"#/$defs/stringDomain"},
            "review_required":{"$ref":"#/$defs/booleanDomain"},
            "is_subscription":{"$ref":"#/$defs/booleanDomain"},
            "property_code":{"$ref":"#/$defs/stringDomain"},
            "rental_unit":{"$ref":"#/$defs/stringDomain"},
            "channel":{"$ref":"#/$defs/stringDomain"},
            "reward_bucket":{"$ref":"#/$defs/stringDomain"}
          }
        },
        "redacted_context":{"type":"object","maxProperties":24,"additionalProperties":{"oneOf":[{"type":"string","maxLength":500},{"type":"number"},{"type":"boolean"},{"type":"null"}]}}
      }
    },
    "stringDomain":{"type":"array","minItems":1,"maxItems":512,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
    "booleanDomain":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"boolean"}}
  }
}
