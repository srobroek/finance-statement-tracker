      "parameters": {
        "jsCode": "// Purpose: Summarize Scheduled Terminal State. Keep this deterministic and fail closed.\nconst rows = $input.all().map(i => i.json), finance = rows.filter(r => String(r.workflowData?.name || r.workflowName || '').startsWith('Finance · ')), failed = finance.filter(r => ['error', 'crashed', 'canceled'].includes(String(r.status).toLowerCase())), running = finance.filter(r => ['new', 'running', 'waiting'].includes(String(r.status).toLowerCase()));\nreturn [{ json: { status: failed.length ? 'ATTENTION' : running.length ? 'RUNNING' : 'OK', execution_count: finance.length, failed_count: failed.length, running_count: running.length, checked_at: new Date().toISOString() } }];\n"
