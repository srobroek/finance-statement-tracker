{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxsan.com/schemas/n8n-data-table-column-disposition-v1.json",
  "title": "n8n Data Table column disposition audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_contract",
    "target_schemas",
    "observability_owners",
    "resolver_contract",
    "rows"
  ],
  "properties": {
    "schema_version": {"const": "n8n-data-table-column-disposition-v1"},
    "generated_at": {"type": "string", "format": "date"},
    "source_contract": {"type": "string", "minLength": 1},
    "target_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finance_ingestion_state", "finance_documents", "finance_actual_batches", "finance_ai_reviews"],
      "properties": {
        "finance_ingestion_state": {"$ref": "#/$defs/nineColumns"},
        "finance_documents": {"$ref": "#/$defs/twentyColumns"},
        "finance_actual_batches": {"$ref": "#/$defs/eighteenColumns"},
        "finance_ai_reviews": {"$ref": "#/$defs/nineColumns"}
      }
    },
    "observability_owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generic_execution_and_failure", "protected_route_access", "agent_traces"],
      "properties": {
        "generic_execution_and_failure": {"const": "n8n"},
        "protected_route_access": {"const": "Cloudflare"},
        "agent_traces": {"const": "optional Langfuse sanitized traces only"}
      }
    },
    "resolver_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "subworkflows", "node_type", "content_addressed", "caller_mutable", "activation_gate"],
      "properties": {
        "owner": {"const": "Git"},
        "subworkflows": {
          "type": "array",
          "prefixItems": [
            {"const": "Resolve Finance Source and Runtime Config"},
            {"const": "Resolve AI Policy and Output Contract"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "node_type": {"const": "n8n-nodes-base.set"},
        "content_addressed": {"const": true},
        "caller_mutable": {"const": false},
        "activation_gate": {"type": "string", "minLength": 1}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "nineColumns": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "eighteenColumns": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "twentyColumns": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "workflowAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_path", "workflow_code", "node_id", "node_name", "operation", "access_kind"],
      "properties": {
        "workflow_path": {"type": "string", "pattern": "^integrations/n8n/workflows/[0-9]{2}-.+\\.json$"},
        "workflow_code": {"type": "string", "pattern": "^WF[0-9]{2}$"},
        "node_id": {"type": "string", "minLength": 1},
        "node_name": {"type": "string", "minLength": 1},
        "operation": {"enum": ["create", "get", "update", "upsert"]},
        "access_kind": {"enum": ["schema", "read", "write"]}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "column",
        "disposition",
        "authoritative_owner",
        "workflow_access",
        "invariant",
        "idempotency",
        "retention",
        "privacy",
        "replacement",
        "migration",
        "rollback"
      ],
      "properties": {
        "table": {"type": "string", "pattern": "^finance_[a-z0-9_]+$"},
        "column": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "disposition": {"type": "string", "minLength": 1},
        "authoritative_owner": {"type": "string", "minLength": 1},
        "workflow_access": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/workflowAccess"}
        },
        "invariant": {"type": "string", "minLength": 1},
        "idempotency": {"type": "string", "minLength": 1},
        "retention": {"type": "string", "minLength": 1},
        "privacy": {"type": "string", "minLength": 1},
        "replacement": {"type": "string", "minLength": 1},
        "migration": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1}
      }
    }
  }
}
