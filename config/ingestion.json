{
  "schema_version": 1,
  "outlook": {
    "cursor_source": "outlook",
    "schedule": {
      "cadence": "DAILY_MORNING_PER_ACTIVE_BANK",
      "timezone": "Asia/Dubai",
      "active_bank_slots": [
        {
          "source": "outlook:rakbank",
          "times": ["08:05"]
        }
      ],
      "paused_bank_slots": [
        {
          "source": "outlook:standard-chartered",
          "times": ["08:25"]
        }
      ]
    },
    "scan_overlap_hours": 2,
    "initial_lookback_hours": 24,
    "transaction_notifications": {
      "mode": "ALL_SINCE_CURSOR_WITH_OVERLAP",
      "source_registry": "config/transaction-email-sources.json"
    },
    "statement_pdfs": {
      "mode": "CARD_SPECIFIC_MONTHLY_JOB",
      "source_registry": "config/statement-sources.json",
      "selection": "LATEST_PER_CARD_AND_EXPECTED_CYCLE",
      "mail_acquisition": {
        "enumeration_workflow": "OUTLOOK_MESSAGE_SWEEP",
        "archive_workflow": "OUTLOOK_FINANCE_ACQUISITION",
        "enumerate_once": true,
        "immutable_identity": ["message_id", "attachment_id"],
        "composite_identity": ["source_message_id", "source_attachment_id"],
        "enumeration_receipt_preread": true,
        "archive_receipt_preread": true,
        "durable_email_evidence_barrier": "REQUIRED",
        "attachment_verification_barrier": "REQUIRED",
        "inline_non_pdf_disposition": "ARCHIVED_ONLY",
        "replay_disposition": "NO_OP"
      }
    }
  },
  "browser": {
    "sources": "config/browser-sources.json",
    "adapters": "browser_adapters",
    "capture_schema": "config/browser-capture-schema-v1.json",
    "prefer_official_export": true,
    "require_review_for_visible_rows": true,
    "allow_direct_actual_write": false
  }
}
