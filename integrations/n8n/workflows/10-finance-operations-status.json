      "parameters": {
        "jsCode": "// Purpose: Build Redacted MCP Terminal Receipt. Keep this deterministic and fail closed.\nconst req = $('Compare ACCEPTED MCP Readback').first().json, raw = $json, error = raw?.error, redact = v => String(v || '').replace(/(password|token|authorization|secret|cookie|account|card)\\s*[:=]\\s*[^\\s,;]+/gi, '$1:[REDACTED]').replace(/[A-Za-z0-9+/_=-]{32,}/g, '[REDACTED]').slice(0, 500);\nconst state = error ? 'FAILED' : 'COMPLETED', result = error ? { error_class: 'MCP_TARGET_ERROR' } : raw;\nreturn [{ json: { ...req, state, error_class: error ? 'MCP_TARGET_ERROR' : '', error_message_redacted: error ? redact(error.message || error) : '', result, result_canonical: JSON.stringify(result) } }];\n"
